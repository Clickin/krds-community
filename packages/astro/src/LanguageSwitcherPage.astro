---
import { cx } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface LanguagePageOption {
  value: string;
  label: string;
  href: string;
  lang?: string;
  disabled?: boolean;
  target?: HTMLAttributes<'a'>['target'];
  rel?: string;
  title?: string;
}

export interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'class:list' | 'open'> {
  languages?: LanguagePageOption[];
  options?: LanguagePageOption[];
  selected?: string;
  value?: string;
  defaultValue?: string;
  label?: string;
  selectedLabel?: string;
  currentLabel?: string;
  text?: string;
  externalTitle?: string;
  open?: boolean;
  defaultOpen?: boolean;
  class?: string;
}

const {
  languages,
  options,
  selected,
  value,
  defaultValue,
  label,
  selectedLabel: _selectedLabel,
  currentLabel,
  text,
  externalTitle,
  open,
  defaultOpen = false,
  class: className,
  id: providedId,
  ...rest
} = Astro.props;
const entries = languages ?? options ?? [];
const activeValue = value ?? selected ?? defaultValue ?? entries[0]?.value;
const current = entries.find((language) => language.value === activeValue);
const links = entries.filter((language) => language.value !== activeValue);
const openState = open ?? defaultOpen;
const languageMenuId = `${providedId ?? `krds-language-${crypto.randomUUID()}`}-menu`;
---


<div {...rest} id={providedId} class={cx('krds-drop-wrap', 'krds-language', className)}>
  <button
    type="button"
    class={cx('krds-btn', 'small', 'text', 'drop-btn', openState && 'active')}
    aria-expanded={openState ? 'true' : 'false'}
    aria-controls={languageMenuId}
  >
    <i class="svg-icon ico-global"></i>{' '}
    {label}{' '}
    <i class="svg-icon ico-toggle"></i>
  </button>
  <div id={languageMenuId} class="drop-menu" style={openState ? 'display: block;' : undefined}>
    <div class="drop-in">
      <div class="drop-top">
        <p class="current-laguage">
          <span>{currentLabel ?? text}</span>
          <strong>{current?.label}</strong>
        </p>
      </div>
      <ul class="drop-list">
        {links.map((language) => (
          <li>
            <a
              href={language.href}
              class="item-link"
              lang={language.lang ?? language.value}
              target={language.target ?? '_blank'}
              rel={language.rel}
              title={language.title ?? externalTitle}
              aria-disabled={language.disabled ? 'true' : undefined}
              tabindex={language.disabled ? -1 : undefined}
            >
              {language.label}<i class="svg-icon ico-go"></i>
              {(language.target ?? '_blank') === '_blank' && <span class="sr-only"></span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.krds-language').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>(':scope > .drop-btn');
    const menu = root.querySelector<HTMLElement>(':scope > .drop-menu');
    if (!button || !menu) return;

    const close = (restoreFocus = false) => {
      menu.style.display = 'none';
      button.classList.remove('active');
      button.setAttribute('aria-expanded', 'false');
      if (restoreFocus) button.focus();
    };
    button.addEventListener('click', () => {
      const nextOpen = button.getAttribute('aria-expanded') !== 'true';
      if (!nextOpen) {
        close();
        return;
      }
      menu.style.display = 'block';
      button.classList.add('active');
      button.setAttribute('aria-expanded', 'true');
    });
    menu.querySelectorAll<HTMLAnchorElement>('.item-link').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (link.getAttribute('aria-disabled') === 'true') {
          event.preventDefault();
          return;
        }
        close();
        root.dispatchEvent(
          new CustomEvent('krds:language-change', {
            bubbles: true,
            detail: { value: link.lang, href: link.href },
          }),
        );
      });
    });
    root.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
      close();
    });
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      close(true);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) close();
    });
  });
</script>
