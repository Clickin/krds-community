---
import type { HTMLAttributes } from 'astro/types';
import type { KrdsCarouselSlide } from '@krds-community/recipes';

export interface CarouselSlide extends KrdsCarouselSlide {
  actionLabel?: string;
  imageAlt?: string;
  imageSrc?: string;
}

export interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'class:list'> {
  slides: CarouselSlide[];
  previousLabel: string;
  nextLabel: string;
  moreLabel: string;
  imageLabel?: string;
  actionLabel: string;
  moreHref?: string;
  autoPlay?: boolean;
  interval?: number;
  initialIndex?: number;
  class?: string;
}

const {
  slides,
  previousLabel,
  nextLabel,
  moreLabel,
  imageLabel,
  actionLabel,
  moreHref = '#',
  autoPlay = false,
  interval = 5000,
  initialIndex = 0,
  class: className,
  ...rest
} = Astro.props;

const safeInitialIndex = slides.length
  ? Math.min(Math.max(Math.trunc(initialIndex), 0), slides.length - 1)
  : 0;
---

<div
  {...rest}
  class:list={['main-vban-wrap', 'bg', className]}
>
  <div class="inner">
    <div class="vb-swiper">
      <div class="swiper">
        <ul class="swiper-wrapper">
          {slides.map((slide) => {
            const resolvedImageLabel = slide.imageAlt ?? imageLabel;
            return (
              <li class="swiper-slide">
                <div class="in">
                  <div class="text">
                    <p class="tit">
                      {slide.title} <br class="w-hide" />{slide.title}
                    </p>
                    <p class="txt">
                      {slide.description} <br class="w-hide" />{slide.description}
                    </p>
                    <a href={slide.href ?? '#'} class="krds-btn primary">
                      {slide.actionLabel ?? actionLabel}
                    </a>
                  </div>
                  <div class="im">
                    {slide.imageSrc ? (
                      <img src={slide.imageSrc} alt={resolvedImageLabel ?? ''} />
                    ) : (
                      <svg
                        width="243"
                        height="178"
                        viewBox="0 0 243 178"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-label={resolvedImageLabel}
                      >
                        <rect
                          width="243"
                          height="178"
                          fill="#E6E8EA"
                        />
                      </svg>
                    )}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
      <button type="button" class="swiper-button-prev">
        <span class="sr-only">{previousLabel}</span>
      </button>
      <button type="button" class="swiper-button-next">
        <span class="sr-only">{nextLabel}</span>
      </button>
      <div class="swiper-indicator text-center">
        <div class="swiper-pagination"></div>
        <a href={moreHref} class="swiper-button-more">
          <span class="sr-only">{moreLabel}</span>
        </a>
      </div>
    </div>
  </div>
</div>
<script
  is:inline
  type="application/json"
  class="krds-carousel-data"
  set:html={JSON.stringify({
    autoPlay,
    initialIndex: safeInitialIndex,
    interval: Math.max(interval, 0),
    slideIds: slides.map((slide) => slide.id),
  })}
></script>

<script>
  const enhancedCarousels = new WeakSet<HTMLElement>();

  function enhanceCarousels() {
    document.querySelectorAll<HTMLElement>('.main-vban-wrap').forEach((root) => {
      if (enhancedCarousels.has(root)) return;
      enhancedCarousels.add(root);
      const dataScript = root.nextElementSibling;
      const data: {
        autoPlay?: boolean;
        initialIndex?: number;
        interval?: number;
        slideIds?: string[];
      } =
        dataScript instanceof HTMLScriptElement && dataScript.classList.contains('krds-carousel-data')
          ? JSON.parse(dataScript.textContent ?? '{}')
          : {};

      const slides = Array.from(root.querySelectorAll<HTMLElement>('.swiper-slide'));
      const previous = root.querySelector<HTMLButtonElement>('.swiper-button-prev');
      const next = root.querySelector<HTMLButtonElement>('.swiper-button-next');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const requestedAutoplay = data.autoPlay === true;
      const interval = Number(data.interval) || 0;
      let current = Math.min(
        Math.max(Number(data.initialIndex) || 0, 0),
        Math.max(slides.length - 1, 0),
      );
      let timer: number | undefined;
      let pointerPaused = false;
      let focusPaused = false;


      function show(index: number, announce: boolean) {
        if (!slides.length) return;
        current = (index + slides.length) % slides.length;
        if (announce) {
          root.dispatchEvent(
            new CustomEvent('krds:slidechange', {
              bubbles: true,
              detail: { index: current, id: data.slideIds?.[current] },
            }),
          );
        }
      }

      function clearTimer() {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = undefined;
      }

      function schedule() {
        clearTimer();
        if (
          !requestedAutoplay ||
          reducedMotion.matches ||
          pointerPaused ||
          focusPaused ||
          slides.length < 2 ||
          interval <= 0
        ) {
          return;
        }
        timer = window.setTimeout(() => {
          show(current + 1, false);
          schedule();
        }, interval);
      }

      previous?.addEventListener('click', () => {
        show(current - 1, true);
        schedule();
      });
      next?.addEventListener('click', () => {
        show(current + 1, true);
        schedule();
      });
      root.addEventListener('mouseenter', () => {
        pointerPaused = true;
        clearTimer();
      });
      root.addEventListener('mouseleave', () => {
        pointerPaused = false;
        schedule();
      });
      root.addEventListener('focusin', () => {
        focusPaused = true;
        clearTimer();
      });
      root.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
        focusPaused = false;
        schedule();
      });
      reducedMotion.addEventListener('change', schedule);

      show(current, false);
      schedule();
    });
  }

  enhanceCarousels();
  document.addEventListener('astro:page-load', enhanceCarousels);
</script>
