---
import { cx } from '@krds-community/recipes';
import type { KrdsTone } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'span'>, 'class' | 'class:list'> {
  label?: string;
  message?: string;
  removeLabel?: string;
  removable?: boolean;
  tone?: KrdsTone;
  class?: string;
}

const {
  label,
  message,
  removeLabel,
  removable = true,
  tone,
  class: className,
  ...rest
} = Astro.props;
const accessibleRemoveLabel = removeLabel ?? message;
---

<span {...rest} class={cx('krds-btn-tag', tone && `bg-${tone}`, className)}>
  <slot>{label}</slot>
  {removable && (
    <button type="button" class="btn-delete">
      <span class="sr-only">{accessibleRemoveLabel}</span>
    </button>
  )}
</span>
