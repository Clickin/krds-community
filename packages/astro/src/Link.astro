---
import { cx } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'class:list' | 'href' | 'size'> {
  href: string;
  label?: string;
  children?: string;
  size?: 'small' | 'medium' | 'large';
  variant?: 'pure' | 'basic';
  external?: boolean;
  underline?: boolean;
  underlineOnInteraction?: boolean;
  icon?: boolean | string;
  class?: string;
}

const {
  href,
  label,
  children,
  size = 'small',
  variant,
  external = false,
  underline = true,
  underlineOnInteraction = false,
  icon = true,
  class: className,
  ...rest
} = Astro.props;
const content = label ?? children;
const iconClass = typeof icon === 'string' ? icon : external ? 'ico-go' : 'ico-angle right';
const labelClass = cx(underline && 'underline', underlineOnInteraction && 'hidden-underline') || undefined;
---

<a {...rest} href={href} class={cx('krds-btn', size, 'link', variant, className)}>
  <span class={labelClass}>
    <slot>{content}</slot>
  </span>
  {icon && (
    <Fragment>
      {' '}
      <slot name="icon">
        <i class={cx('svg-icon', iconClass)}></i>
      </slot>
    </Fragment>
  )}
</a>
