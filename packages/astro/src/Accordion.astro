---
import { accordionRecipe, cx } from '@krds-community/recipes';
import type { AccordionProps } from './types';

export interface Props extends AccordionProps {
  defaultOpen?: string[];
  open?: string[];
}

const {
  items = [],
  type = 'default',
  multiple = false,
  defaultOpen = [],
  open,
  class: className,
  ...rest
} = Astro.props;
const recipe = accordionRecipe({ type, className });
const initialOpen = open ?? defaultOpen;
const openIds = new Set(multiple ? initialOpen : initialOpen.slice(0, 1));
const instanceId = `krds-accordion-${crypto.randomUUID()}`;
const renderedItems = items.map((item, index) => ({
  item,
  expanded: openIds.has(item.id),
  headerId: `${instanceId}-header-${index}`,
  panelId: `${instanceId}-panel-${index}`,
}));
---

<div
  {...rest}
  class={recipe.className}
>
  {renderedItems.map(({ item, expanded, headerId, panelId }) => (
    <div class={cx('accordion-item', expanded && 'active')}>
      <h5 class="accordion-header">
        <button
          type="button"
          id={headerId}
          class={cx('btn-accordion', expanded && 'active')}
          aria-expanded={expanded ? 'true' : 'false'}
          aria-controls={panelId}
          disabled={item.disabled}
        >
          {item.title}
        </button>
      </h5>
      <div
        id={panelId}
        class={cx('accordion-collapse', 'collapse', expanded && 'show')}
        role="region"
        aria-labelledby={headerId}
        hidden={!expanded}
      >
        <div class="accordion-body">{item.content}</div>
      </div>
    </div>
  ))}
</div>
<script
  is:inline
  type="application/json"
  class="krds-accordion-data"
  set:html={JSON.stringify({ multiple })}
></script>

<script>
  const accordionPanelFor = (root: HTMLElement, button: HTMLButtonElement) => {
    const panelId = button.getAttribute('aria-controls');
    if (!panelId) return null;
    const panel = document.getElementById(panelId);
    return panel instanceof HTMLElement && root.contains(panel) ? panel : null;
  };

  const setAccordionExpanded = (
    root: HTMLElement,
    button: HTMLButtonElement,
    expanded: boolean,
  ) => {
    const panel = accordionPanelFor(root, button);
    if (!panel) return;
    button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    button.classList.toggle('active', expanded);
    button.closest('.accordion-item')?.classList.toggle('active', expanded);
    panel.hidden = !expanded;
    panel.classList.toggle('show', expanded);
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('button.btn-accordion');
    if (!button || button.disabled) return;
    const root = button.closest<HTMLElement>('.krds-accordion');
    if (!root) return;

    const expanded = button.getAttribute('aria-expanded') !== 'true';
    const dataScript = root.nextElementSibling;
    const allowsMultiple =
      dataScript instanceof HTMLScriptElement && dataScript.classList.contains('krds-accordion-data')
        ? JSON.parse(dataScript.textContent ?? '{}').multiple === true
        : false;
    if (expanded && !allowsMultiple) {
      root.querySelectorAll<HTMLButtonElement>('button.btn-accordion').forEach((candidate) => {
        if (candidate !== button && candidate.closest('.krds-accordion') === root) {
          setAccordionExpanded(root, candidate, false);
        }
      });
    }
    setAccordionExpanded(root, button, expanded);
  });
</script>
