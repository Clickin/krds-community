---
import type { HTMLAttributes } from 'astro/types';
import { cx, inputRecipe } from '@krds-community/recipes';

export interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'class:list'> {
  label?: string;
  hint?: string;
  year: number;
  month: number;
  years: number[];
  displayYear?: number;
  displayMonth?: number;
  selectedYear?: number;
  selectedMonth?: number;
  disabledYears?: number[];
  disabledMonths?: number[];
  leadingDays: number;
  previousMonthDayCount: number;
  dayCount: number;
  weekdays: string[];
  rangeStartDay?: number;
  rangeEndDay?: number;
  todayDay?: number;
  eventDays?: number[];
  disabledDays?: number[];
  calendarLabel?: string;
  previousMonthLabel?: string;
  nextMonthLabel?: string;
  yearSelectLabel?: string;
  monthSelectLabel?: string;
  todayLabel?: string;
  cancelLabel?: string;
  confirmLabel?: string;
  eventLabel?: string;
  inputId?: string;
  inputName?: string;
  inputValue?: string | number;
  inputPlaceholder?: string;
  inputType?: HTMLAttributes<'input'>['type'];
  inputAttributes?: Omit<HTMLAttributes<'input'>, 'class:list' | 'id' | 'name' | 'type' | 'value'>;
  openCalendarLabel?: string;
  open?: boolean;
  selectionMode?: 'single' | 'range';
  calendarId?: string;
  calendarClass?: string;
  calendarAttributes?: Omit<HTMLAttributes<'div'>, 'class' | 'class:list' | 'id'>;
  surfaceOnly?: boolean;
  class?: string;
}

const {
  label,
  hint,
  year: providedYear,
  month: providedMonth,
  displayYear,
  displayMonth,
  selectedYear,
  selectedMonth,
  years,
  disabledYears = [],
  disabledMonths = [],
  leadingDays,
  previousMonthDayCount,
  dayCount,
  weekdays,
  rangeStartDay,
  rangeEndDay,
  todayDay,
  eventDays = [],
  disabledDays = [],
  calendarLabel,
  previousMonthLabel = '이전 달',
  nextMonthLabel = '다음 달',
  yearSelectLabel = '연도 선택',
  monthSelectLabel = '월 선택',
  todayLabel,
  cancelLabel,
  confirmLabel,
  eventLabel,
  inputId: providedInputId,
  inputName,
  inputValue,
  inputPlaceholder,
  inputType = 'number',
  inputAttributes = {},
  openCalendarLabel,
  open = false,
  selectionMode = 'single',
  calendarId: providedCalendarId,
  calendarClass,
  calendarAttributes = {},
  surfaceOnly = true,
  class: className,
  ...rest
} = Astro.props;

const instanceId = `krds-calendar-${crypto.randomUUID()}`;
const inputId = providedInputId ?? `${instanceId}-input`;
const calendarId = providedCalendarId ?? `${instanceId}-popup`;
const yearListId = `${calendarId}-year-list`;
const monthListId = `${calendarId}-month-list`;
const hintId = hint !== undefined || Astro.slots.has('hint') ? `${inputId}-hint` : undefined;
const year = displayYear ?? providedYear ?? new Date().getFullYear();
const month = displayMonth ?? providedMonth ?? new Date().getMonth() + 1;
const activeYear = selectedYear ?? providedYear ?? year;
const activeMonth = selectedMonth ?? providedMonth ?? month;
const yearOptions = years && years.length > 0 ? years : [year];
const weekdayNames = weekdays && weekdays.length > 0 ? weekdays : ['일', '월', '화', '수', '목', '금', '토'];
const pad = (value: number) => String(value).padStart(2, '0');
const leadingDaysValue = leadingDays ?? new Date(year, month - 1, 1).getDay();
const previousMonthDayCountValue = previousMonthDayCount ?? new Date(year, month - 1, 0).getDate();
const dayCountValue = dayCount ?? new Date(year, month, 0).getDate();
const previousMonth = month === 1 ? 12 : month - 1;
const previousYear = month === 1 ? year - 1 : year;
const nextMonth = month === 12 ? 1 : month + 1;
const nextYear = month === 12 ? year + 1 : year;
const cells = Array.from({ length: 42 }, (_, index) => {
  const offset = index - leadingDaysValue;
  const old = offset < 0;
  const next = offset >= dayCountValue;
  const day = old
    ? previousMonthDayCountValue + offset + 1
    : next
      ? offset - dayCountValue + 1
      : offset + 1;
  const cellYear = old ? previousYear : next ? nextYear : year;
  const cellMonth = old ? previousMonth : next ? nextMonth : month;
  const current = !old && !next;
  const period =
    current &&
    rangeStartDay !== undefined &&
    rangeEndDay !== undefined &&
    day >= rangeStartDay &&
    day <= rangeEndDay;
  const start = period && day === rangeStartDay;
  const end = period && day === rangeEndDay;
  const today = current && day === todayDay;
  const event = current && eventDays.includes(day);
  const disabled = current && disabledDays.includes(day);
  return {
    day,
    date: `${cellYear}.${pad(cellMonth)}.${pad(day)}`,
    outside: old || next,
    disabled,
    period,
    today,
    event,
    className: cx(
      old && 'old',
      next && 'new',
      period && 'period',
      start && 'start',
      end && 'end',
      index % 7 === 0 && 'day-off',
      event && 'day-event',
      today && 'today',
      disabled && 'disabled',
    ),
  };
});
const inputRecipeResult = inputRecipe();
const inputDescribedBy = [inputAttributes['aria-describedby'], hintId].filter(Boolean).join(' ') || undefined;
---

{surfaceOnly ? (
  <div
    {...calendarAttributes}
    class={cx('krds-calendar-area', open && 'active', calendarClass)}
    data-astro-calendar-area
  >
    <div
      class={cx('calendar-wrap', 'bottom', selectionMode === 'single' && 'single')}
      aria-label={calendarLabel}
      tabindex="0"
    >
      <div class="calendar-head">
        <button type="button" class="btn-cal-move prev">
          <span class="sr-only">{previousMonthLabel}</span>
        </button>
        <div class="calendar-switch-wrap">
          <div class="calendar-drop-down">
            <button
              type="button"
              class="btn-cal-switch year"
              aria-label={yearSelectLabel}
              aria-controls={yearListId}
              aria-expanded="false"
              aria-haspopup="listbox"
              role="combobox"
            >{year}년</button>
            <div class="calendar-select calendar-year-wrap">
              <ul class="sel year" id={yearListId} role="listbox">
                {yearOptions.map((optionYear) => (
                  <li role="none">
                    <button
                      type="button"
                      class={optionYear === activeYear ? 'active' : undefined}
                      role="option"
                      aria-selected={optionYear === activeYear ? 'true' : 'false'}
                      disabled={disabledYears.includes(optionYear)}
                    >{optionYear}년</button>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="calendar-drop-down">
            <button
              type="button"
              class="btn-cal-switch month"
              aria-label={monthSelectLabel}
              aria-controls={monthListId}
              aria-expanded="false"
              aria-haspopup="listbox"
              role="combobox"
            >{pad(month)}월</button>
            <div class="calendar-select calendar-mon-wrap">
              <ul class="sel month" id={monthListId} role="listbox">
                {Array.from({ length: 12 }, (_, index) => index + 1).map((optionMonth) => (
                  <li role="none">
                    <button
                      type="button"
                      class={optionMonth === activeMonth ? 'active' : undefined}
                      role="option"
                      aria-selected={optionMonth === activeMonth ? 'true' : 'false'}
                      disabled={disabledMonths.includes(optionMonth)}
                    >{pad(optionMonth)}월</button>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <button type="button" class="btn-cal-move next">
          <span class="sr-only">{nextMonthLabel}</span>
        </button>
      </div>
      <div class="calendar-body">
        <div class="calendar-table-wrap">
          <table class="calendar-tbl">
            <caption>{year}년 {pad(month)}월</caption>
            <thead>
              <tr>{weekdayNames.map((weekday) => <th>{weekday}</th>)}</tr>
            </thead>
            <tbody>
              {Array.from({ length: 6 }, (_, rowIndex) => (
                <tr>
                  {cells.slice(rowIndex * 7, rowIndex * 7 + 7).map((cell) => (
                    <td class={cell.className || undefined} data-date={cell.date}>
                      <button
                        type="button"
                        class="btn-set-date"
                        disabled={cell.outside ? 'true' : cell.disabled}
                        aria-pressed={cell.period ? 'true' : undefined}
                        aria-label={
                          cell.today
                            ? `${cell.day} ${todayLabel ?? ''}`.trim()
                            : cell.event
                              ? `${cell.day} ${eventLabel ?? ''}`.trim()
                              : undefined
                        }
                      ><span>{cell.day}</span></button>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="calendar-footer">
        <div class="calendar-btn-wrap">
          <button type="button" class="krds-btn small text" id={`${calendarId}-today`}>{todayLabel}</button>
          <button type="button" class="krds-btn small tertiary">{cancelLabel}</button>
          <button type="button" class="krds-btn small primary">{confirmLabel}</button>
        </div>
      </div>
    </div>
  </div>
) : (
  <div {...rest} class={cx('form-group', className)} data-astro-calendar-root>
    {(label !== undefined || Astro.slots.has('label')) && (
      <div class="form-tit">
        {/* ponytail: label stays sr-only — react/vue render the calendar surface only, so a visible label breaks text parity; sr-only keeps the input's accessible name */}
        <label for={inputId} class="sr-only"><slot name="label">{label}</slot></label>
      </div>
    )}
    <div class="form-conts calendar-conts">
      <div class="calendar-input">
        <input
          {...inputAttributes}
          type={inputType}
          class={cx(inputRecipeResult.className, 'datepicker', 'cal', inputAttributes.class)}
          placeholder={inputPlaceholder}
          id={inputId}
          name={inputName}
          value={inputValue}
          aria-describedby={inputDescribedBy}
        />
        <button
          type="button"
          class="krds-btn medium icon form-btn-datepicker"
        >
          <span class="sr-only">{openCalendarLabel ?? '달력 열기'}</span>
          <i class="svg-icon ico-calendar"></i>
        </button>
      </div>
      <Astro.self
        surfaceOnly={true}
        selectionMode={selectionMode}
        year={providedYear}
        month={providedMonth}
        displayYear={year}
        displayMonth={month}
        selectedYear={activeYear}
        selectedMonth={activeMonth}
        years={years}
        disabledYears={disabledYears}
        disabledMonths={disabledMonths}
        leadingDays={leadingDays}
        previousMonthDayCount={previousMonthDayCount}
        dayCount={dayCount}
        weekdays={weekdays}
        rangeStartDay={rangeStartDay}
        rangeEndDay={rangeEndDay}
        todayDay={todayDay}
        eventDays={eventDays}
        disabledDays={disabledDays}
        calendarLabel={calendarLabel}
        previousMonthLabel={previousMonthLabel}
        nextMonthLabel={nextMonthLabel}
        yearSelectLabel={yearSelectLabel}
        monthSelectLabel={monthSelectLabel}
        todayLabel={todayLabel}
        cancelLabel={cancelLabel}
        confirmLabel={confirmLabel}
        eventLabel={eventLabel}
        open={open}
        calendarId={calendarId}
        calendarClass={calendarClass}
        calendarAttributes={calendarAttributes}
      />
    </div>
    {hintId && <p id={hintId} class="form-hint"><slot name="hint">{hint}</slot></p>}
  </div>
)}

<script>
  const calendarAreaFor = (element: Element) => element.closest<HTMLElement>('.krds-calendar-area');
  const calendarRootFor = (element: Element) => {
    const area = element.closest<HTMLElement>('[data-astro-calendar-area]');
    return area?.closest<HTMLElement>('[data-astro-calendar-root]') ?? area;
  };
  const padCalendarPart = (value: number) => String(value).padStart(2, '0');

  const closeCalendarSelects = (area: HTMLElement, except?: HTMLElement) => {
    area.querySelectorAll<HTMLElement>('.calendar-select.active').forEach((select) => {
      if (select !== except) select.classList.remove('active');
    });
    area.querySelectorAll<HTMLButtonElement>('.btn-cal-switch').forEach((button) => {
      const select = button.nextElementSibling;
      button.setAttribute('aria-expanded', select === except ? 'true' : 'false');
    });
  };

  const closeCalendar = (root: HTMLElement, restoreFocus = false) => {
    const area = root.matches('.krds-calendar-area')
      ? root
      : root.querySelector<HTMLElement>('.krds-calendar-area');
    const trigger = root.querySelector<HTMLButtonElement>('.form-btn-datepicker');
    if (!area) return;
    closeCalendarSelects(area);
    area.classList.remove('active');
    if (restoreFocus) trigger?.focus();
  };

  const selectedCalendarPart = (area: HTMLElement, part: 'year' | 'month') => {
    const text = area.querySelector<HTMLButtonElement>(`.btn-cal-switch.${part}`)?.textContent ?? '';
    return Number.parseInt(text, 10);
  };

  const updateCalendarDates = (area: HTMLElement) => {
    const year = selectedCalendarPart(area, 'year');
    const month = selectedCalendarPart(area, 'month');
    if (!Number.isFinite(year) || !Number.isFinite(month)) return;
    const caption = area.querySelector('caption');
    if (caption) caption.textContent = `${year}년 ${padCalendarPart(month)}월`;
    area.querySelectorAll<HTMLTableCellElement>('td[data-date]').forEach((cell) => {
      const day = Number.parseInt(cell.textContent ?? '', 10);
      let cellYear = year;
      let cellMonth = month;
      if (cell.classList.contains('old')) {
        cellMonth -= 1;
        if (cellMonth === 0) {
          cellMonth = 12;
          cellYear -= 1;
        }
      } else if (cell.classList.contains('new')) {
        cellMonth += 1;
        if (cellMonth === 13) {
          cellMonth = 1;
          cellYear += 1;
        }
      }
      cell.dataset.date = `${cellYear}.${padCalendarPart(cellMonth)}.${padCalendarPart(day)}`;
    });
  };

  const setCalendarPart = (area: HTMLElement, part: 'year' | 'month', value: number) => {
    const trigger = area.querySelector<HTMLButtonElement>(`.btn-cal-switch.${part}`);
    if (!trigger) return;
    trigger.textContent = part === 'year' ? `${value}년` : `${padCalendarPart(value)}월`;
    const list = area.querySelector<HTMLElement>(`.sel.${part}`);
    list?.querySelectorAll<HTMLButtonElement>('button').forEach((option) => {
      const selected = Number.parseInt(option.textContent ?? '', 10) === value;
      option.classList.toggle('active', selected);
      option.setAttribute('aria-selected', selected ? 'true' : 'false');
    });
    updateCalendarDates(area);
  };

  const clearCalendarSelection = (area: HTMLElement) => {
    area.querySelectorAll<HTMLTableCellElement>('td.period, td.start, td.end').forEach((cell) => {
      cell.classList.remove('period', 'start', 'end');
      cell.querySelector('.btn-set-date')?.removeAttribute('aria-pressed');
    });
    delete area.dataset.rangeStart;
    delete area.dataset.rangeComplete;
  };

  const selectSingleCalendarCell = (area: HTMLElement, cell: HTMLTableCellElement) => {
    clearCalendarSelection(area);
    cell.classList.add('period', 'start', 'end');
    cell.querySelector('.btn-set-date')?.setAttribute('aria-pressed', 'true');
    area.dataset.rangeStart = cell.dataset.date ?? '';
    area.dataset.rangeComplete = 'true';
  };

  const selectCalendarRange = (area: HTMLElement, cell: HTMLTableCellElement) => {
    const date = cell.dataset.date;
    if (!date) return;
    const pendingStart = area.dataset.rangeComplete === 'true' ? undefined : area.dataset.rangeStart;
    if (!pendingStart || date < pendingStart) {
      clearCalendarSelection(area);
      cell.classList.add('period', 'start');
      cell.querySelector('.btn-set-date')?.setAttribute('aria-pressed', 'true');
      area.dataset.rangeStart = date;
      return;
    }
    area.querySelectorAll<HTMLTableCellElement>('td[data-date]').forEach((candidate) => {
      const candidateDate = candidate.dataset.date;
      if (!candidateDate || candidateDate < pendingStart || candidateDate > date) return;
      candidate.classList.add('period');
      candidate.querySelector('.btn-set-date')?.setAttribute('aria-pressed', 'true');
    });
    area.querySelector<HTMLTableCellElement>(`td[data-date="${CSS.escape(pendingStart)}"]`)?.classList.add('start');
    cell.classList.add('end');
    area.dataset.rangeComplete = 'true';
  };

  const dispatchCalendarInput = (input: HTMLInputElement, value: string) => {
    input.type = 'text';
    input.value = value;
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.dispatchEvent(new Event('change', { bubbles: true }));
  };

  const calendarRoots = () =>
    [
      ...document.querySelectorAll<HTMLElement>('[data-astro-calendar-root]'),
      ...Array.from(document.querySelectorAll<HTMLElement>('[data-astro-calendar-area]')).filter(
        (area) => !area.closest('[data-astro-calendar-root]'),
      ),
    ];

  document.addEventListener('click', (event) => {
    const eventTarget = event.target;
    if (!(eventTarget instanceof Node)) return;
    calendarRoots().forEach((root) => {
      if (!root.contains(eventTarget)) closeCalendar(root);
    });
    if (!(eventTarget instanceof Element)) return;

    const action = eventTarget.closest<HTMLElement>(
      '.btn-cal-move, .calendar-btn-wrap button, .form-btn-datepicker',
    );
    const option = eventTarget.closest<HTMLButtonElement>('.calendar-select button');
    const dayButton = eventTarget.closest<HTMLButtonElement>('.btn-set-date');
    const switchButton = eventTarget.closest<HTMLButtonElement>('.btn-cal-switch');
    const target = action ?? option ?? dayButton ?? switchButton;
    if (!target) return;
    const root = calendarRootFor(target);
    const area = calendarAreaFor(target) ?? root?.querySelector<HTMLElement>('.krds-calendar-area');
    if (!area) return;

    if (switchButton) {
      const select = switchButton.nextElementSibling;
      if (!(select instanceof HTMLElement)) return;
      const opening = !select.classList.contains('active');
      closeCalendarSelects(area, opening ? select : undefined);
      select.classList.toggle('active', opening);
      switchButton.setAttribute('aria-expanded', opening ? 'true' : 'false');
      return;
    }

    if (option && !option.disabled) {
      const part = option.closest('.sel.year') ? 'year' : 'month';
      setCalendarPart(area, part, Number.parseInt(option.textContent ?? '', 10));
      closeCalendarSelects(area);
      area.querySelector<HTMLButtonElement>(`.btn-cal-switch.${part}`)?.focus();
      return;
    }

    if (dayButton && !dayButton.disabled) {
      const cell = dayButton.closest('td');
      if (!(cell instanceof HTMLTableCellElement)) return;
      if (area.querySelector('.calendar-wrap.single')) selectSingleCalendarCell(area, cell);
      else selectCalendarRange(area, cell);
      return;
    }

    const actionName = action
      ? action.classList.contains('form-btn-datepicker')
        ? 'toggle'
        : action.classList.contains('prev')
          ? 'previous'
          : action.classList.contains('next')
            ? 'next'
            : (() => {
                const buttons = Array.from(action.parentElement?.querySelectorAll('button') ?? []);
                const index = buttons.indexOf(action as HTMLButtonElement);
                return index === 0 ? 'today' : index === 1 ? 'cancel' : 'confirm';
              })()
      : undefined;

    if (action && actionName === 'toggle' && root) {
      const opening = !area.classList.contains('active');
      if (opening) calendarRoots().forEach((candidate) => candidate !== root && closeCalendar(candidate));
      area.classList.toggle('active', opening);
      if (opening) area.querySelector<HTMLElement>('.calendar-wrap')?.focus();
      return;
    }
    if (actionName === 'previous' || actionName === 'next') {
      let nextYear = selectedCalendarPart(area, 'year');
      let nextMonth = selectedCalendarPart(area, 'month') + (actionName === 'previous' ? -1 : 1);
      if (nextMonth === 0) {
        nextMonth = 12;
        nextYear -= 1;
      } else if (nextMonth === 13) {
        nextMonth = 1;
        nextYear += 1;
      }
      setCalendarPart(area, 'year', nextYear);
      setCalendarPart(area, 'month', nextMonth);
      return;
    }
    if (actionName === 'today') {
      const todayCell = area.querySelector<HTMLTableCellElement>('td.today');
      if (todayCell) selectSingleCalendarCell(area, todayCell);
      return;
    }
    if (actionName === 'cancel' && root) {
      closeCalendar(root, true);
      return;
    }
    if (actionName === 'confirm' && root) {
      const start = area.querySelector<HTMLTableCellElement>('td.start')?.dataset.date ?? '';
      const end = area.querySelector<HTMLTableCellElement>('td.end')?.dataset.date ?? '';
      const rangeInputs = Array.from(root.querySelectorAll<HTMLInputElement>('.input-group.range input'));
      if (rangeInputs.length >= 2) {
        dispatchCalendarInput(rangeInputs[0], start);
        dispatchCalendarInput(rangeInputs[1], end);
      } else {
        const input = root.querySelector<HTMLInputElement>('.datepicker.cal');
        if (input) dispatchCalendarInput(input, area.querySelector('.calendar-wrap.single') ? start : `${start} ~ ${end}`);
      }
      closeCalendar(root, true);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(event.target instanceof Element)) return;
    const area = calendarAreaFor(event.target);
    if (!area) return;
    const root = calendarRootFor(event.target);
    const openSelect = area.querySelector<HTMLElement>('.calendar-select.active');
    if (openSelect) {
      closeCalendarSelects(area);
      area.querySelector<HTMLButtonElement>('.btn-cal-switch[aria-expanded="false"]')?.focus();
    } else if (root) {
      closeCalendar(root, true);
    }
  });
</script>
