---
import { cx } from '@krds-community/recipes';

export interface Props {
  size?: 'large' | 'medium';
  state?: 'active' | 'success' | 'error';
  value?: number;
  max?: number;
  label?: string;
  class?: string;
}

const {
  size = 'medium',
  state = 'active',
  value = 0,
  max = 100,
  label,
  class: className,
} = Astro.props;
---

<div class={cx('krds-progress-bar', size, state, className)}>
  <progress class="krds-progress" value={value} max={max}>
    {label ?? `${value}%`}
  </progress>
  {label && <span class="progress-label">{label}</span>}
</div>
