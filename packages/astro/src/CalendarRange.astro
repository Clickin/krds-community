---
import { cx } from '@krds-community/recipes';
import Calendar from './Calendar.astro';
import type { Props as CalendarProps } from './Calendar.astro';

export interface Props extends Omit<CalendarProps, 'selectionMode' | 'surfaceOnly'> {}

const {
  class: className,
  calendarClass,
  ...props
} = Astro.props;
---

<Calendar
  {...props}
  surfaceOnly={true}
  selectionMode="range"
  calendarClass={cx(calendarClass, className)}
/>
