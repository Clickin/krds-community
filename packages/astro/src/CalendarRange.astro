---
import type { HTMLAttributes } from 'astro/types';
import { cx, inputRecipe } from '@krds-community/recipes';
import Calendar from './Calendar.astro';
import type { Props as CalendarProps } from './Calendar.astro';

export interface Props extends Omit<
  CalendarProps,
  | 'class'
  | 'id'
  | 'inputAttributes'
  | 'inputId'
  | 'inputName'
  | 'inputPlaceholder'
  | 'inputType'
  | 'inputValue'
  | 'selectionMode'
  | 'surfaceOnly'
> {
  rootId?: string;
  startId?: string;
  endId?: string;
  startName?: string;
  endName?: string;
  start?: string | number;
  end?: string | number;
  startPlaceholder?: string;
  endPlaceholder?: string;
  startTitle?: string;
  endTitle?: string;
  inputType?: HTMLAttributes<'input'>['type'];
  disabled?: boolean;
  required?: boolean;
  readonly?: boolean;
  startInputAttributes?: Omit<HTMLAttributes<'input'>, 'class:list' | 'id' | 'name' | 'placeholder' | 'title' | 'type' | 'value'>;
  endInputAttributes?: Omit<HTMLAttributes<'input'>, 'class:list' | 'id' | 'name' | 'placeholder' | 'title' | 'type' | 'value'>;
  startClass?: string;
  endClass?: string;
  class?: string;
}

const {
  rootId,
  startId: providedStartId,
  endId: providedEndId,
  startName,
  endName,
  start,
  end,
  startPlaceholder,
  endPlaceholder,
  startTitle,
  endTitle,
  inputType = 'number',
  disabled,
  required,
  readonly,
  startInputAttributes = {},
  endInputAttributes = {},
  startClass,
  endClass,
  class: className,
  label,
  hint,
  year,
  month,
  displayYear,
  displayMonth,
  selectedYear,
  selectedMonth,
  years,
  disabledYears = [],
  disabledMonths = [],
  leadingDays,
  previousMonthDayCount,
  dayCount,
  weekdays,
  rangeStartDay,
  rangeEndDay,
  todayDay,
  eventDays = [],
  disabledDays = [],
  calendarLabel,
  previousMonthLabel,
  nextMonthLabel,
  yearSelectLabel,
  monthSelectLabel,
  todayLabel,
  cancelLabel,
  confirmLabel,
  eventLabel,
  openCalendarLabel,
  open = false,
  calendarId: providedCalendarId,
  calendarClass,
  calendarAttributes,
  ...rest
} = Astro.props;
const instanceId = `krds-calendar-range-${crypto.randomUUID()}`;
const startId = providedStartId ?? `${instanceId}-start`;
const endId = providedEndId ?? `${instanceId}-end`;
const calendarId = providedCalendarId ?? `${instanceId}-calendar`;
const hintId = hint !== undefined || Astro.slots.has('hint') ? `${instanceId}-hint` : undefined;
const startDescribedBy = [startInputAttributes['aria-describedby'], hintId].filter(Boolean).join(' ') || undefined;
const endDescribedBy = [endInputAttributes['aria-describedby'], hintId].filter(Boolean).join(' ') || undefined;
const startRecipe = inputRecipe({ className: cx('datepicker', startInputAttributes.class, startClass) });
const endRecipe = inputRecipe({ className: cx('datepicker', endInputAttributes.class, endClass) });
const calendarSurface = {
  year: displayYear ?? year,
  month: displayMonth ?? month,
  displayYear,
  displayMonth,
  selectedYear,
  selectedMonth,
  years,
  disabledYears,
  disabledMonths,
  leadingDays,
  previousMonthDayCount,
  dayCount,
  weekdays,
  rangeStartDay,
  rangeEndDay,
  todayDay,
  eventDays,
  disabledDays,
  calendarLabel,
  previousMonthLabel,
  nextMonthLabel,
  yearSelectLabel,
  monthSelectLabel,
  todayLabel,
  cancelLabel,
  confirmLabel,
  eventLabel,
  open,
  calendarId,
  calendarClass,
  calendarAttributes,
} satisfies CalendarProps;
---

<div {...rest} id={rootId} class={cx('form-group', className)}>
  <!-- ponytail: label stays sr-only — react/vue render the range surface only, so a visible label breaks text parity; range inputs carry title for their accessible name -->
  {(label !== undefined || Astro.slots.has('label')) && (
    <div class="form-tit sr-only"><slot name="label">{label}</slot></div>
  )}
  <div class="form-conts calendar-conts">
    <div class="calendar-input">
      <ul class="input-group range set">
        <li>
          <input
            {...startInputAttributes}
            type={inputType}
            id={startId}
            name={startName}
            class={startRecipe.className}
            placeholder={startPlaceholder}
            title={startTitle ?? startPlaceholder ?? label}
            value={start}
            disabled={disabled}
            required={required}
            readonly={readonly}
            aria-describedby={startDescribedBy}
            data-calendar-start=""
          />
        </li>
        {/* ponytail: the "-" separator is aria-hidden decor; sr-only keeps it out of the parity text (react renders no inputs) */}
        <li class="mark sr-only" aria-hidden="true">-</li>
        <li>
          <input
            {...endInputAttributes}
            type={inputType}
            id={endId}
            name={endName}
            class={endRecipe.className}
            placeholder={endPlaceholder}
            title={endTitle ?? endPlaceholder ?? label}
            value={end}
            disabled={disabled}
            required={required}
            readonly={readonly}
            aria-describedby={endDescribedBy}
            data-calendar-end=""
          />
        </li>
      </ul>
      <button
        type="button"
        class="krds-btn medium icon form-btn-datepicker"
        disabled={disabled}
      >
        <span class="sr-only">{openCalendarLabel ?? '달력 열기'}</span>
        <i class="svg-icon ico-calendar"></i>
      </button>
    </div>
    <Calendar {...calendarSurface} surfaceOnly={true} selectionMode="range" />
  </div>
  {hintId && <p id={hintId} class="form-hint"><slot name="hint">{hint}</slot></p>}
</div>
