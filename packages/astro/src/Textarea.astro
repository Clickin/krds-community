---
import type { HTMLAttributes } from 'astro/types';
import { inputRecipe } from '@krds-community/recipes';

export interface Props extends Omit<HTMLAttributes<'textarea'>, 'class' | 'class:list' | 'maxlength' | 'value'> {
  label?: string;
  hint?: string;
  value?: string | number;
  maxLength?: number;
  currentLength?: number;
  class?: string;
}

const {
  id: providedId,
  label,
  hint,
  value,
  maxLength,
  currentLength,
  'aria-describedby': consumerDescribedBy,
  class: className,
  ...rest
} = Astro.props;
const id = providedId ?? `krds-textarea-${crypto.randomUUID()}`;
const hintId = hint !== undefined || Astro.slots.has('hint') ? `${id}-hint` : undefined;
const initialValue = value === undefined ? '' : String(value);
const count = currentLength ?? Array.from(initialValue).length;
const recipe = inputRecipe({ className });
---

<div class="form-group">
  {(label !== undefined || Astro.slots.has('label')) && (
    <div class="form-tit">
      <label for={id}><slot name="label">{label}</slot></label>
    </div>
  )}
  <div class="form-conts">
    <div class="textarea-wrap">
      <textarea
        {...rest}
        class={recipe.className}
        id={id}
        maxlength={maxLength}
        aria-describedby={consumerDescribedBy}
      >{initialValue}</textarea>
      {maxLength !== undefined && (
        <p class="textarea-count" aria-live="polite">
          <span class="count-now">{count}</span><span class="count-total">/{maxLength}</span>
        </p>
      )}
    </div>
  </div>
  {hintId && <p id={hintId} class="form-hint"><slot name="hint">{hint}</slot></p>}
</div>

<script>
  document.addEventListener('input', (event) => {
    if (!(event.target instanceof HTMLTextAreaElement) || event.target.maxLength < 0) return;
    const root = event.target.closest<HTMLElement>('.form-group');
    const count = root?.querySelector<HTMLElement>('.textarea-count .count-now');
    if (count) count.textContent = String(Array.from(event.target.value).length);
  });
</script>
