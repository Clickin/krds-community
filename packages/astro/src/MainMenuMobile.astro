---
import { cx } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface MobileMenuItem {
  id?: string;
  label: string;
  href?: string;
  active?: boolean;
  current?: boolean;
  disabled?: boolean;
  target?: HTMLAttributes<'a'>['target'];
  rel?: string;
  title?: string;
  children?: MobileMenuItem[];
}

export interface Props
  extends Omit<HTMLAttributes<'div'>, 'class' | 'class:list' | 'id' | 'role'> {
  id?: string;
  utilityItems?: MobileMenuItem[];
  loginLabel?: string;
  loginHref?: string;
  serviceItems?: MobileMenuItem[];
  searchPlaceholder?: string;
  searchTitle?: string;
  searchLabel?: string;
  searchName?: string;
  searchValue?: string;
  defaultSearchValue?: string;
  items?: MobileMenuItem[];
  previousLabel?: string;
  closeLabel?: string;
  bottomItems?: MobileMenuItem[];
  bottomSize?: 'small' | 'medium';
  closeButtonId?: string;
  sample?: boolean;
  open?: boolean;
  standalone?: boolean;
  navigationLabel?: string;
  class?: string;
  className?: string;
}

const {
  id = 'mobile-nav',
  utilityItems = [],
  loginLabel,
  loginHref,
  serviceItems = [],
  searchPlaceholder,
  searchTitle,
  searchLabel,
  searchName,
  searchValue,
  defaultSearchValue,
  items = [],
  previousLabel,
  closeLabel,
  bottomItems = [],
  bottomSize: providedBottomSize,
  closeButtonId = 'close-nav',
  sample = false,
  open = false,
  standalone: _standalone = true,
  navigationLabel,
  className: classNameProp,
  class: classAttribute,
  style,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;
const className = classNameProp ?? classAttribute;

const selectedTopExists = items.some((item) => item.active);
const bottomSize = providedBottomSize ?? (sample ? 'small' : 'medium');
const itemKey = (item: MobileMenuItem) =>
  item.id ?? item.label.trim().replace(/[^a-zA-Z0-9_-]+/g, '-');
const panelId = (item: MobileMenuItem) => item.id ?? `${id}-panel-${itemKey(item)}`;
const tabId = (item: MobileMenuItem) => `${id}-tab-${itemKey(item)}`;
const depth3Id = (item: MobileMenuItem) => `${id}-depth3-${itemKey(item)}`;
const depth4Id = (item: MobileMenuItem) => `${id}-depth4-${itemKey(item)}`;
---

<div
  {...rest}
  id={id}
  role="navigation"
  class={cx('krds-main-menu-mobile', sample && !className ? 'sample' : undefined, open && 'is-open', className)}
  style={style}
  aria-label={ariaLabel ?? navigationLabel}
  data-krds-main-menu-mobile
>
  <div class="gnb-wrap">
    <div class="gnb-header">
      <div class="gnb-utils">
        <ul class="gnb-utils-list">
          {utilityItems.map((item) => (
            <li>
              {item.href ? (
                <a
                  href={item.href}
                  class="krds-btn xsmall text"
                  target={item.target}
                  rel={item.rel}
                  title={item.title}
                  aria-current={item.current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <button type="button" class="krds-btn xsmall text" disabled={item.disabled}>
                  {item.label}
                </button>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="gnb-login">
        {loginHref ? (
          <a href={loginHref} class="krds-btn large text">
            <i class="svg-icon ico-log" aria-hidden="true"></i> {loginLabel}
          </a>
        ) : (
          <button type="button" class="krds-btn large text">
            <i class="svg-icon ico-log" aria-hidden="true"></i> {loginLabel}
          </button>
        )}
      </div>
      <div class="gnb-service-menu">
        {serviceItems.map((item) => (
          item.href ? (
            <a
              href={item.href}
              class="link"
              target={item.target}
              rel={item.rel}
              title={item.title}
              aria-current={item.current ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <button type="button" class="link" disabled={item.disabled}>{item.label}</button>
          )
        ))}
      </div>
      <div class="sch-input">
        <input
          type="text"
          class="krds-input"
          placeholder={searchPlaceholder}
          title={searchTitle}
          name={searchName}
          value={searchValue ?? defaultSearchValue}
        />
        <button type="button" class="krds-btn medium icon ico-search" data-mobile-search>
          <span class="sr-only">{searchLabel}</span>
          <i class="svg-icon ico-sch" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="gnb-body">
      <div class="gnb-menu">
        <div class="menu-wrap">
          <ul role="tablist">
            {items.map((item, index) => {
              const active = Boolean(item.active || (!selectedTopExists && index === 0));
              return (
                <li role="none">
                  <a
                    id={tabId(item)}
                    href={item.href ?? `#${panelId(item)}`}
                    class={cx('gnb-main-trigger', active && 'active')}
                    role="tab"
                    aria-selected={active ? 'true' : 'false'}
                    aria-controls={panelId(item)}
                    aria-disabled={item.disabled ? 'true' : undefined}
                    tabindex={item.disabled ? -1 : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
        <div class="submenu-wrap">
          {items.map((item) => (
            <div class="gnb-sub-list" id={panelId(item)} role="tabpanel" aria-labelledby={tabId(item)}>
              <h2 class="sub-title">{item.label}</h2>
              <ul>
                {item.children?.map((second) => {
                  const hasDepth3 = Boolean(second.children?.length);
                  return (
                    <li>
                      <a
                        href={second.href ?? '#'}
                        class={cx('gnb-sub-trigger', hasDepth3 && 'has-depth3', second.active && 'active')}
                        target={second.target}
                        rel={second.rel}
                        title={second.title}
                        aria-current={second.current ? 'page' : undefined}
                        aria-controls={hasDepth3 ? depth3Id(second) : undefined}
                        aria-expanded={hasDepth3 ? (second.active ? 'true' : 'false') : undefined}
                        aria-disabled={second.disabled ? 'true' : undefined}
                        tabindex={second.disabled ? -1 : undefined}
                      >
                        {second.label}
                      </a>
                      {hasDepth3 && (
                        <div
                          id={depth3Id(second)}
                          class={cx('depth3-wrap', second.active && 'is-open')}
                        >
                          <ul>
                            {second.children?.map((third) => {
                              const hasDepth4 = Boolean(third.children?.length);
                              return (
                                <li>
                                  <a
                                    href={third.href ?? '#'}
                                    class={cx('depth3-trigger', hasDepth4 && 'has-depth4')}
                                    target={third.target}
                                    rel={third.rel}
                                    title={hasDepth4 ? undefined : third.title}
                                    aria-current={third.current ? 'page' : undefined}
                                    aria-controls={hasDepth4 ? depth4Id(third) : undefined}
                                    aria-expanded={hasDepth4 ? 'false' : undefined}
                                    aria-disabled={third.disabled ? 'true' : undefined}
                                    tabindex={third.disabled ? -1 : undefined}
                                  >
                                    {third.label}
                                  </a>
                                  {hasDepth4 && (
                                    <div id={depth4Id(third)} class="depth4-wrap">
                                      <div class="depth4-head">
                                        <button type="button" class="krds-btn icon trigger-prev">
                                          <span class="sr-only">{previousLabel}</span>
                                          <i class="svg-icon ico-angle left" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="krds-btn icon trigger-close">
                                          <span class="sr-only">{closeLabel}</span>
                                          <i class="svg-icon ico-popup-close" aria-hidden="true"></i>
                                        </button>
                                      </div>
                                      <div class="depth4-body">
                                        <h4 class="sub-title">{third.title}</h4>
                                        <ul class="depth4-ul">
                                          {third.children?.map((fourth) => (
                                            <li>
                                              {fourth.href ? (
                                                <a
                                                  href={fourth.href}
                                                  target={fourth.target}
                                                  rel={fourth.rel}
                                                  title={fourth.title}
                                                  aria-current={fourth.current ? 'page' : undefined}
                                                >
                                                  {fourth.label}
                                                </a>
                                              ) : (
                                                <button type="button" disabled={fourth.disabled}>{fourth.label}</button>
                                              )}
                                            </li>
                                          ))}
                                        </ul>
                                      </div>
                                    </div>
                                  )}
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <div class="gnb-bottom">
        {bottomItems.map((item) => (
          item.href ? (
            <a
              href={item.href}
              class={cx('krds-btn', bottomSize, 'text')}
              target={item.target}
              rel={item.rel}
              title={item.title}
              aria-current={item.current ? 'page' : undefined}
            >
              {item.label}
              <i
                class={cx('svg-icon', item.target ? 'ico-go' : 'ico-angle right')}
                aria-hidden="true"
              ></i>
            </a>
          ) : (
            <button type="button" class={cx('krds-btn', bottomSize, 'text')} disabled={item.disabled}>
              {item.label} <i class="svg-icon ico-angle right" aria-hidden="true"></i>
            </button>
          )
        ))}
      </div>
    </div>
    <button type="button" class="krds-btn medium icon" id={closeButtonId} data-mobile-close>
      <span class="sr-only">{closeLabel}</span>
      <i class="svg-icon ico-popup-close" aria-hidden="true"></i>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-krds-main-menu-mobile]').forEach((root) => {
    const wrap = root.querySelector<HTMLElement>(':scope > .gnb-wrap');
    const body = root.querySelector<HTMLElement>('.gnb-body');
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('.menu-wrap [role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.submenu-wrap > .gnb-sub-list'));
    const closeButton = root.querySelector<HTMLButtonElement>('[data-mobile-close]');
    const opener = Array.from(document.querySelectorAll<HTMLElement>('[aria-controls]')).find(
      (element) => element.getAttribute('aria-controls') === root.id,
    );
    const sample = root.classList.contains('sample');
    if (!wrap || !body) return;

    const activateTab = (tab: HTMLAnchorElement, scroll = true) => {
      if (tab.getAttribute('aria-disabled') === 'true') return;
      tabs.forEach((candidate) => {
        const active = candidate === tab;
        candidate.classList.toggle('active', active);
        candidate.setAttribute('aria-selected', String(active));
      });
      const panel = root.querySelector<HTMLElement>(`#${CSS.escape(tab.getAttribute('aria-controls') ?? '')}`);
      if (scroll && panel) body.scrollTo({ top: panel.offsetTop, behavior: 'smooth' });
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        activateTab(tab);
      });
    });
    body.addEventListener('scroll', () => {
      let activePanel = panels[0];
      panels.forEach((panel) => {
        if (body.scrollTop >= panel.offsetTop) activePanel = panel;
      });
      const tab = tabs.find((candidate) => candidate.getAttribute('aria-controls') === activePanel?.id);
      if (tab) activateTab(tab, false);
    });

    root.querySelectorAll<HTMLAnchorElement>('.has-depth3').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        if (trigger.getAttribute('aria-disabled') === 'true') return;
        event.preventDefault();
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        trigger.classList.toggle('active', !expanded);
        trigger.setAttribute('aria-expanded', String(!expanded));
        trigger.nextElementSibling?.classList.toggle('is-open', !expanded);
      });
    });
    root.querySelectorAll<HTMLAnchorElement>('.has-depth4').forEach((trigger) => {
      const panel = trigger.nextElementSibling as HTMLElement | null;
      if (!panel) return;
      const previous = panel.querySelector<HTMLButtonElement>('.trigger-prev');
      const close = panel.querySelector<HTMLButtonElement>('.trigger-close');
      const closeDepth = () => {
        panel.classList.remove('is-open');
        panel.style.removeProperty('display');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      };
      trigger.addEventListener('click', (event) => {
        if (trigger.getAttribute('aria-disabled') === 'true') return;
        event.preventDefault();
        panel.style.display = 'block';
        panel.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        previous?.focus();
      });
      previous?.addEventListener('click', closeDepth);
      close?.addEventListener('click', closeDepth);
      panel.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        event.preventDefault();
        closeDepth();
      });
    });

    const openMenu = () => {
      root.style.display = 'block';
      root.classList.add('is-backdrop', 'is-open');
      root.setAttribute('aria-hidden', 'false');
      wrap.setAttribute('tabindex', '0');
      opener?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('is-gnb-mobile');
      wrap.focus();
      root.dispatchEvent(new CustomEvent('krds:menu-open', { bubbles: true }));
    };
    const closeMenu = (restoreFocus = true) => {
      root.classList.remove('is-backdrop', 'is-open');
      root.setAttribute('aria-hidden', 'true');
      opener?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('is-gnb-mobile');
      if (!sample) root.style.display = 'none';
      if (restoreFocus) opener?.focus();
      root.dispatchEvent(new CustomEvent('krds:menu-close', { bubbles: true }));
    };
    opener?.addEventListener('click', openMenu);
    closeButton?.addEventListener('click', () => closeMenu());
    if (!sample && !root.classList.contains('is-open')) closeMenu(false);

    root.querySelector<HTMLButtonElement>('[data-mobile-search]')?.addEventListener('click', () => {
      const input = root.querySelector<HTMLInputElement>('.sch-input .krds-input');
      root.dispatchEvent(
        new CustomEvent('krds:search', {
          bubbles: true,
          detail: { value: input?.value ?? '' },
        }),
      );
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== 'Tab' || !root.classList.contains('is-open') || sample) return;
      const focusable = Array.from(
        root.querySelectorAll<HTMLElement>(
          'a[href]:not([aria-disabled="true"]), button:not(:disabled), input:not(:disabled), [tabindex]:not([tabindex="-1"])',
        ),
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
  });
</script>
