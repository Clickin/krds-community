---
import { switchRecipe } from '@krds-community/recipes';
import type { ChoiceProps } from './types';

export interface Props extends ChoiceProps {
  checked?: boolean;
}

const {
  id: providedId,
  label,
  description,
  size,
  disabled,
  checked,
  'aria-describedby': consumerDescribedBy,
  class: className,
  ...rest
} = Astro.props;
const id = providedId ?? `krds-toggle-switch-${crypto.randomUUID()}`;
const hasDescription = description !== undefined || Astro.slots.has('description');
const descriptionId = hasDescription ? `${id}-description` : undefined;
const ariaDescribedBy = [consumerDescribedBy, descriptionId].filter(Boolean).join(' ') || undefined;
const recipe = switchRecipe({ size, className });
---

<div class={recipe.className}>
  <input
    {...rest}
    id={id}
    type="checkbox"
    disabled={disabled}
    checked={checked}
    aria-describedby={ariaDescribedBy}
  />
  <label for={id}>
    <span class="switch-toggle"><i></i></span><slot>{label}</slot>
  </label>
  {hasDescription && (
    <span id={descriptionId} class="krds-field-message">
      <slot name="description">{description}</slot>
    </span>
  )}
</div>
