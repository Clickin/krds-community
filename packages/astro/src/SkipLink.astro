---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'class:list' | 'href'> {
  href: string;
  label?: string;
  children?: string;
  containerId?: string;
  containerClass?: string;
  class?: string;
}

const {
  href,
  label,
  children,
  containerId = 'krds-skip-link',
  containerClass,
  class: className,
  ...rest
} = Astro.props;
---

<div id={containerId} class={containerClass}>
  <a {...rest} href={href} class={className}><slot>{label ?? children}</slot></a>
</div>
