---
import { cx } from '@krds-community/recipes';
import type { ButtonProps } from './types';

export interface Props extends ButtonProps {
  label: string;
  iconClass?: string;
  size?: 'small' | 'medium' | 'large';
}

const {
  label,
  iconClass = 'ico-sch',
  variant,
  size,
  disabled,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;
---

<button
  {...rest}
  type={type}
  disabled={disabled}
  class={cx('krds-btn', 'icon', size, variant, className)}
>
  <span class="sr-only">{label}</span>
  <slot name="icon"><i class={cx('svg-icon', iconClass)} aria-hidden="true"></i></slot>
</button>
