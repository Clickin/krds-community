---
import Select from './Select.astro';
import type { Props as SelectProps } from './Select.astro';

export interface Props extends Omit<SelectProps, 'surfaceOnly' | 'variant'> {}

const { state = 'error', class: className, ...rest } = Astro.props;
---

<Select {...rest} state={state} class={className} variant="state">
  {Astro.slots.has('default') && <slot />}
  <Fragment slot="label"><slot name="label">{rest.label}</slot></Fragment>
  <Fragment slot="hint"><slot name="hint">{rest.hint}</slot></Fragment>
</Select>
