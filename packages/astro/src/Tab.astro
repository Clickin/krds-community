---
import { cx, tabRecipe } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface TabItem {
  id: string;
  label: string;
  disabled?: boolean;
  tabId?: string;
  panelId?: string;
}

export interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'class:list'> {
  tabs?: TabItem[];
  panels?: Record<string, string>;
  defaultValue?: string;
  selected?: string;
  value?: string;
  message?: string;
  panelTitle?: string | Record<string, string>;
  class?: string;
}

const {
  tabs = [],
  panels = {},
  defaultValue,
  selected,
  value,
  message,
  panelTitle,
  class: className,
  ...rest
} = Astro.props;
const activeValue = value ?? selected ?? defaultValue ?? tabs[0]?.id;
const tabId = (tab: TabItem) => tab.tabId ?? `tab_${tab.id}`;
const panelId = (tab: TabItem) => tab.panelId ?? `panel_${tab.id}`;
const resolvePanelTitle = (tab: TabItem) =>
  typeof panelTitle === 'string' ? panelTitle : panelTitle?.[tab.id];
const tabClasses = tabRecipe({ full: true });
---

<div {...rest} class={cx(tabClasses.root, className)}>
  <div class={tabClasses.listContainer}>
    <ul role="tablist">
      {tabs.map((tab) => {
        const active = tab.id === activeValue;
        return (
          <li
            role="presentation"
            class={tabRecipe({ full: true, active }).item}
          >
            <button
              id={tabId(tab)}
              type="button"
              role="tab"
              aria-selected={active ? 'true' : 'false'}
              aria-controls={panelId(tab)}
              tabindex={active ? 0 : -1}
              class={tabClasses.trigger}
              disabled={tab.disabled}
            >
              {tab.label}
              {active && message && <i class="sr-only created"> {message}</i>}
            </button>
          </li>
        );
      })}
    </ul>
  </div>
  <div class="tab-conts-wrap">
    {tabs.map((tab) => {
      const active = tab.id === activeValue;
      return (
        <section
          id={panelId(tab)}
          role="tabpanel"
          aria-labelledby={tabId(tab)}
          class={cx('tab-conts', active && 'active')}
          data-quick-nav="false"
          hidden={!active}
        >
          {resolvePanelTitle(tab) && <h3 class="sr-only">{resolvePanelTitle(tab)}</h3>}
          {panels[tab.id]}
        </section>
      );
    })}
  </div>
</div>

<script>
  import { tabRecipe } from '@krds-community/recipes';

  const activeClass = tabRecipe({ active: true }).item!;
  document.querySelectorAll<HTMLElement>('.krds-tab-area').forEach((area) => {
    const tabElements = Array.from(area.querySelectorAll<HTMLButtonElement>('button[role="tab"]'));
    const panels = Array.from(area.querySelectorAll<HTMLElement>(':scope > .tab-conts-wrap > .tab-conts'));
    const selectionMessage =
      area.querySelector<HTMLElement>('[role="tab"][aria-selected="true"] .created')?.textContent ?? '';

    const selectTab = (tab: HTMLButtonElement) => {
      if (tab.getAttribute('aria-disabled') === 'true') return;
      const controlledPanel = tab.getAttribute('aria-controls');
      tabElements.forEach((candidate) => {
        const active = candidate === tab;
        candidate.closest('li')?.classList.toggle(activeClass, active);
        candidate.tabIndex = active ? 0 : -1;
        candidate.setAttribute('aria-selected', String(active));
        candidate.querySelector('.created')?.remove();
      });
      panels.forEach((panel) => {
        const active = panel.id === controlledPanel;
        panel.classList.toggle(activeClass, active);
        panel.hidden = !active;
      });
      if (selectionMessage) {
        const text = document.createElement('i');
        text.className = 'sr-only created';
        text.textContent = selectionMessage;
        tab.append(text);
      }
      area.dispatchEvent(
        new CustomEvent('krds:tab-change', {
          bubbles: true,
          detail: { id: tab.id, panelId: controlledPanel },
        }),
      );
    };

    tabElements.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        const enabled = tabElements.filter(
          (candidate) => candidate.getAttribute('aria-disabled') !== 'true',
        );
        const currentIndex = enabled.indexOf(tab);
        let next: HTMLButtonElement | undefined;
        if (event.key === 'ArrowRight') next = enabled[(currentIndex + 1) % enabled.length];
        else if (event.key === 'ArrowLeft') {
          next = enabled[(currentIndex - 1 + enabled.length) % enabled.length];
        } else if (event.key === 'Home') next = enabled[0];
        else if (event.key === 'End') next = enabled[enabled.length - 1];
        if (!next) return;
        event.preventDefault();
        selectTab(next);
        next.focus();
      });
      if (index === 0 && !area.querySelector('[role="tab"][aria-selected="true"]')) selectTab(tab);
    });
  });
</script>
