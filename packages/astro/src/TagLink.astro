---
import { cx } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'class:list' | 'href'> {
  href: string;
  label?: string;
  class?: string;
}

const { href, label, class: className, ...rest } = Astro.props;
---

<a {...rest} href={href} class={cx('krds-btn-tag', 'link', className)}>
  <slot>{label}</slot>
</a>
