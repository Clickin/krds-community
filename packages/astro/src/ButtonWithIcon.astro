---
import { cx } from '@krds-community/recipes';
import type { ButtonProps } from './types';

export interface Props extends ButtonProps {
  label?: string;
  children?: string;
  iconClass?: string;
  className?: string;
}

const {
  label,
  children,
  iconClass = 'ico-sch',
  variant,
  size,
  disabled,
  type = 'button',
  className: classNameProp,
  class: classAttribute,
  ...rest
} = Astro.props;
const className = classNameProp ?? classAttribute;
---

<button
  {...rest}
  type={type}
  disabled={disabled}
  class={cx('krds-btn', variant, size, className)}
>
  <slot>{children ?? label}</slot>
  <slot name="icon"><i class={cx('svg-icon', iconClass)} aria-hidden="true"></i></slot>
</button>
