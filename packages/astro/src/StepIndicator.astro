---
import { cx } from '@krds-community/recipes';
import type { HTMLAttributes } from 'astro/types';

export interface StepIndicatorItem {
  id: string;
  label: string;
  description?: string;
  disabled?: boolean;
}

export interface Props extends Omit<HTMLAttributes<'ol'>, 'class' | 'class:list'> {
  steps?: StepIndicatorItem[];
  current?: number;
  label?: string;
  message?: string;
  class?: string;
}

const {
  steps = [],
  current = 0,
  label,
  message,
  class: className,
  ...rest
} = Astro.props;
---

<ol {...rest} class={cx('krds-step-wrap', className)}>
  {steps.map((item, index) => (
    <li
      class={index < current ? 'done' : index === current ? 'active' : undefined}
      aria-current={index === current ? 'step' : undefined}
      aria-disabled={item.disabled ? 'true' : undefined}
    >
      <span>
        {index === current && message && <em class="sr-only">{message}</em>}
        <i class="step">{index + 1}{label}</i>
        <span class="step-tit">{item.label}</span>
        {item.description && <span class="sr-only">{item.description}</span>}
      </span>
    </li>
  ))}
</ol>
