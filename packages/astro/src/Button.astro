---
import { buttonRecipe } from '@krds-community/recipes';
import type { ButtonProps } from './types';

export interface Props extends ButtonProps {
  label?: string;
  children?: string;
  className?: string;
}

const {
  label,
  children,
  variant,
  size,
  disabled,
  type = 'button',
  className: classNameProp,
  class: classAttribute,
  ...rest
} = Astro.props;
const className = classNameProp ?? classAttribute;
const recipe = buttonRecipe({ variant, size, disabled, className });
---

<button
  {...rest}
  type={type}
  disabled={disabled}
  class={recipe.className}
>
  <slot>{children ?? label}</slot>
</button>
