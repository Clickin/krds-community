{
  "name": "@krds-community/solid",
  "version": "0.1.0",
  "description": "KRDS용 SolidJS 네이티브 컴포넌트.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.tsx"
    },
    "./extra": {
      "types": "./dist/extra.d.ts",
      "import": "./src/extra.tsx"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && vite build --config scripts/vite.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@krds-community/recipes": "workspace:*",
    "@krds-community/styles": "workspace:*"
  },
  "devDependencies": {
    "solid-js": "1.9.14",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.13"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  }
}
