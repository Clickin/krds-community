{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "composite": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@krds-community/recipes": ["../packages/recipes/src/index.ts"],
      "@krds-community/conformance": ["../packages/conformance/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../apps/conformance-host/src/protocol.ts", "../packages/cli/src/deps.ts"],
  "exclude": [
    "dist",
    "docs-links.test.ts",
    "conformance-adapter.test.ts",
    "framework/**/*.ts",
    "framework/**/*.tsx"
  ],
  "references": [
    { "path": "../packages/recipes/tsconfig.json" },
    { "path": "../packages/conformance/tsconfig.json" }
  ]
}
