---
export type Props = { patternId: string };

const { patternId } = Astro.props;
const id = `astro-${patternId}`;
---

<div class="astro-pattern-example" data-astro-pattern={patternId}>
  {patternId === 'visit' && (
    <section aria-labelledby={`${id}-title`}>
      <p class="pattern-eyebrow">정부서비스</p>
      <h3 id={`${id}-title`}>필요한 서비스를 빠르게 찾아보세요.</h3>
      <nav aria-label="주요 서비스">
        <a href="#application">민원 신청</a>
        <a href="#policy">정책 정보</a>
      </nav>
    </section>
  )}

  {patternId === 'search' && (
    <form
      role="search"
      data-astro-form
      data-query-success="검색 결과 3건"
      data-success="검색어를 입력하세요."
    >
      <label for={`${id}-query`}>서비스 검색</label>
      <div class="pattern-inline">
        <input id={`${id}-query`} type="search" data-query />
        <button type="submit">검색</button>
      </div>
      <output aria-live="polite" data-astro-message>검색어를 입력하면 결과를 확인할 수 있습니다.</output>
    </form>
  )}

  {patternId === 'login' && (
    <form aria-labelledby={`${id}-title`} data-astro-form data-success="로그인되었습니다.">
      <h3 id={`${id}-title`}>로그인</h3>
      <label for={`${id}-user`}>아이디</label>
      <input id={`${id}-user`} name={`${id}-user`} autocomplete="username" required />
      <label for={`${id}-password`}>비밀번호</label>
      <input id={`${id}-password`} name={`${id}-password`} type="password" autocomplete="current-password" required />
      <button type="submit">로그인</button>
      <a href="#find-id">아이디·비밀번호 찾기</a>
      <output role="status" data-astro-message></output>
    </form>
  )}

  {patternId === 'application' && (
    <form aria-labelledby={`${id}-title`} data-astro-form data-success="신청 내용이 저장되었습니다.">
      <h3 id={`${id}-title`}>서비스 신청</h3>
      <label for={`${id}-name`}>신청인</label>
      <input id={`${id}-name`} name="name" autocomplete="name" required />
      <label for={`${id}-purpose`}>신청 내용</label>
      <textarea id={`${id}-purpose`} name="purpose" required></textarea>
      <button type="submit">신청하기</button>
      <output role="status" data-astro-message></output>
    </form>
  )}

  {patternId === 'policy' && (
    <article aria-labelledby={`${id}-title`}>
      <p class="pattern-eyebrow">정책 정보</p>
      <h3 id={`${id}-title`}>디지털 포용 계획</h3>
      <p>정책의 목적과 주요 내용을 정확하고 최신 상태로 확인합니다.</p>
      <a href="#download">정책 자료 내려받기</a>
    </article>
  )}

  {patternId === 'personal-information' && (
    <fieldset>
      <legend>개인 식별 정보</legend>
      <p id={`${id}-hint`}>본인 확인에 필요한 정보만 입력하세요.</p>
      <label for={`${id}-name`}>이름</label>
      <input id={`${id}-name`} name="name" autocomplete="name" aria-describedby={`${id}-hint`} required />
      <label for={`${id}-birth`}>생년월일</label>
      <input id={`${id}-birth`} name="birth" inputmode="numeric" required />
    </fieldset>
  )}

  {patternId === 'help' && (
    <section aria-labelledby={`${id}-title`}>
      <h3 id={`${id}-title`}>도움말</h3>
      <details>
        <summary>신청 방법을 알고 싶어요</summary>
        <p>신청서를 작성하고 내용을 확인한 뒤 제출하세요.</p>
      </details>
      <a href="#guide">이용 안내 보기</a>
    </section>
  )}

  {patternId === 'consent' && (
    <form data-astro-form data-success="동의 내용을 확인했습니다.">
      <fieldset>
        <legend>약관 동의</legend>
        <details>
          <summary>서비스 이용약관</summary>
          <p>서비스 이용에 필요한 약관 전문입니다.</p>
        </details>
        <label>
          <input type="checkbox" required data-consent />
          이용약관에 동의합니다.
        </label>
        <button type="submit">다음</button>
        <output role="status" data-astro-message></output>
      </fieldset>
    </form>
  )}

  {patternId === 'list' && (
    <section aria-labelledby={`${id}-title`}>
      <h3 id={`${id}-title`}>공지사항</h3>
      <ul class="pattern-list">
        <li><a href="#notice-1">서비스 이용 안내</a><time datetime="2026-07-01">2026.07.01</time></li>
        <li><a href="#notice-2">시스템 점검 안내</a><time datetime="2026-06-28">2026.06.28</time></li>
      </ul>
      <nav aria-label="페이지 이동">
        <a href="#previous">이전</a>
        <a href="#next">다음</a>
      </nav>
    </section>
  )}

  {patternId === 'feedback' && (
    <form data-astro-form data-success="의견을 보내주셔서 감사합니다.">
      <fieldset>
        <legend>서비스 이용 의견</legend>
        <div class="pattern-inline">
          <label><input type="radio" name={`${id}-satisfaction`} value="good" required /> 만족</label>
          <label><input type="radio" name={`${id}-satisfaction`} value="normal" /> 보통</label>
          <label><input type="radio" name={`${id}-satisfaction`} value="bad" /> 불만족</label>
        </div>
        <label for={`${id}-message`}>의견</label>
        <textarea id={`${id}-message`}></textarea>
        <button type="submit">의견 보내기</button>
        <output role="status" data-astro-message></output>
      </fieldset>
    </form>
  )}

  {patternId === 'detail' && (
    <article aria-labelledby={`${id}-title`}>
      <p class="pattern-eyebrow">정책 자료</p>
      <h3 id={`${id}-title`}>디지털 정부서비스 이용 안내</h3>
      <p>서비스의 대상과 이용 방법, 처리 절차를 자세히 안내합니다.</p>
      <h4>처리 절차</h4>
      <ol><li>정보 확인</li><li>신청서 작성</li><li>결과 확인</li></ol>
    </article>
  )}

  {patternId === 'error' && (
    <section role="alert" aria-labelledby={`${id}-title`}>
      <h3 id={`${id}-title`}>요청을 처리하지 못했습니다.</h3>
      <p>잠시 후 다시 시도하거나 입력 내용을 확인해 주세요.</p>
      <button type="button" data-message="다시 시도하는 중입니다.">다시 시도</button>
      <a href="#help">도움말</a>
      <output role="status" data-astro-message></output>
    </section>
  )}

  {patternId === 'form' && (
    <form aria-labelledby={`${id}-title`} data-astro-form data-success="입력 내용이 저장되었습니다.">
      <h3 id={`${id}-title`}>정보 입력</h3>
      <label for={`${id}-subject`}>제목</label>
      <input id={`${id}-subject`} required />
      <label for={`${id}-category`}>분류</label>
      <select id={`${id}-category`} required>
        <option value="" disabled selected>선택하세요</option>
        <option>민원</option>
        <option>정책</option>
      </select>
      <button type="submit">저장</button>
      <output role="status" data-astro-message></output>
    </form>
  )}

  {patternId === 'attachment' && (
    <section aria-labelledby={`${id}-title`}>
      <h3 id={`${id}-title`}>첨부 파일</h3>
      <ul><li><a href="#file" download>서비스 안내서.pdf <span>(2.4MB)</span></a></li></ul>
    </section>
  )}

  {patternId === 'filter-sort' && (
    <form aria-labelledby={`${id}-title`} data-astro-form data-success="최신순으로 정렬했습니다.">
      <h3 id={`${id}-title`}>검색 결과</h3>
      <fieldset>
        <legend>필터와 정렬</legend>
        <label><input type="checkbox" name={`${id}-type`} value="civil" /> 민원</label>
        <label><input type="checkbox" name={`${id}-type`} value="policy" /> 정책</label>
        <label for={`${id}-sort`}>정렬</label>
        <select id={`${id}-sort`} data-sort>
          <option>최신순</option>
          <option>관련도순</option>
        </select>
        <button type="submit">적용</button>
      </fieldset>
      <output aria-live="polite" data-astro-message>결과 12건</output>
    </form>
  )}

  {patternId === 'confirm' && (
    <details>
      <summary>제출 전 확인 열기</summary>
      <section aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`}>
        <h3 id={`${id}-title`}>신청을 제출할까요?</h3>
        <p id={`${id}-description`}>제출한 뒤에는 내용을 수정할 수 없습니다.</p>
        <div class="pattern-inline">
          <button type="button" data-message="제출을 취소했습니다.">취소</button>
          <button type="button" data-message="신청을 제출했습니다.">제출</button>
        </div>
        <output role="status" data-astro-message></output>
      </section>
    </details>
  )}

  {patternId === 'mobile-notification' && (
    <section aria-labelledby={`${id}-title`}>
      <h3 id={`${id}-title`}>알림</h3>
      <p role="status">신청 결과가 준비되었습니다.</p>
      <button type="button" data-message="알림함을 열었습니다.">알림함 열기</button>
      <output role="status" data-astro-message></output>
    </section>
  )}

  {patternId === 'mobile-settings' && (
    <form aria-labelledby={`${id}-title`}>
      <h3 id={`${id}-title`}>앱 설정</h3>
      <label for={`${id}-push`}>푸시 알림</label>
      <input id={`${id}-push`} type="checkbox" role="switch" checked data-live-switch />
      <a href="#security">보안 설정</a>
      <output role="status" data-astro-message>푸시 알림 켜짐</output>
    </form>
  )}

  {patternId !== 'visit' && patternId !== 'search' && patternId !== 'login' && patternId !== 'application' && patternId !== 'policy' && patternId !== 'personal-information' && patternId !== 'help' && patternId !== 'consent' && patternId !== 'list' && patternId !== 'feedback' && patternId !== 'detail' && patternId !== 'error' && patternId !== 'form' && patternId !== 'attachment' && patternId !== 'filter-sort' && patternId !== 'confirm' && patternId !== 'mobile-notification' && patternId !== 'mobile-settings' && (
    <p role="status">알 수 없는 패턴입니다.</p>
  )}
</div>

<script>
  const bindAstroPatternExamples = () => {
    document.querySelectorAll<HTMLElement>('[data-astro-pattern]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const setMessage = (value: string) => {
        const message = root.querySelector<HTMLElement>('[data-astro-message]');
        if (message) message.textContent = value;
      };

      root.querySelectorAll<HTMLFormElement>('form[data-astro-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const query = form.querySelector<HTMLInputElement>('[data-query]')?.value.trim();
          const selectedSort = form.querySelector<HTMLSelectElement>('[data-sort]')?.value;
          if (query && form.dataset.querySuccess) {
            setMessage(`‘${query}’ ${form.dataset.querySuccess}`);
            return;
          }
          if (selectedSort) {
            setMessage(`${selectedSort}으로 정렬했습니다.`);
            return;
          }
          setMessage(form.dataset.success ?? '제출 결과를 확인하세요.');
        });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-message]').forEach((button) => {
        button.addEventListener('click', () => setMessage(button.dataset.message ?? '완료되었습니다.'));
      });

      root.querySelectorAll<HTMLInputElement>('[data-live-switch]').forEach((input) => {
        input.addEventListener('change', () => setMessage(`푸시 알림 ${input.checked ? '켜짐' : '꺼짐'}`));
      });
    });
  };

  bindAstroPatternExamples();
  document.addEventListener('astro:page-load', bindAstroPatternExamples);
</script>
