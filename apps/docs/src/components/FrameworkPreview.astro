---
/* ---------------------------------------------------------------------------
 * FrameworkPreview — named slot 기반 프레임워크 미리보기 (모범/피해야 할 사례 통합).
 *
 * MDX에서 사용:
 *
 *   <FrameworkPreview title="버튼">
 *     <ReactButton slot="react" label="버튼" client:only="react" />
 *     <VueButton slot="vue" label="버튼" client:only="vue" />
 *     <SvelteButton slot="svelte" label="버튼" client:only="svelte" />
 *     <SolidButton slot="solid" label="버튼" client:only="solid-js" />
 *     <AngularButton slot="angular" label="버튼" client:only="@analogjs/astro-angular" />
 *     <AstroButton slot="astro" label="버튼" />
 *   </FrameworkPreview>
 *
 *   <FrameworkPreview kind="good" title="한 페이지에 최상위 수준의 강조 버튼은 한 번만 사용한다.">
 *     <div slot="react"><ReactButton variant="primary">확인</ReactButton></div>
 *     …
 *   </FrameworkPreview>
 *
 * 각 slot 이름은 프레임워크 ID와 일치해야 함.
 * 각 framework component에는 MDX에서 `client:only`를 직접 붙인다.
 * remark 플러그인이 주입한 `code`가 전부 비어 있으면(컴포넌트 페이지
 * 가이드라인 예시) 코드 패널 없이 탭 + 미리보기만 렌더한다.
 * --------------------------------------------------------------------------- */

import { Code } from 'astro:components';
import { krdsShikiHighContrast, krdsShikiLight } from '../theme/krds-shiki';
import '../styles/framework-tabs.css';
import AngularIcon from './icons/AngularIcon.astro';
import AstroIcon from './icons/AstroIcon.astro';
import ReactIcon from './icons/ReactIcon.astro';
import SolidIcon from './icons/SolidIcon.astro';
import SvelteIcon from './icons/SvelteIcon.astro';
import VueIcon from './icons/VueIcon.astro';

export type Framework = 'react' | 'vue' | 'svelte' | 'solid' | 'angular' | 'astro';

export interface Props {
  /** good = 모범 사례, bad = 피해야 할 사례 (없으면 표준 프레임워크 예제 헤더) */
  kind?: 'good' | 'bad';
  title?: string;
  /** remark-framework-preview adds a document-local occurrence number. */
  previewId?: string;
  /** remark 플러그인이 주입한 코드 객체 */
  code?: Partial<Record<Framework, string>>;
}

const { kind, title, previewId, code: codeMap = {} } = Astro.props;

const frameworks = [
  { id: 'react', label: 'React', Icon: ReactIcon },
  { id: 'vue', label: 'Vue', Icon: VueIcon },
  { id: 'svelte', label: 'Svelte', Icon: SvelteIcon },
  { id: 'solid', label: 'SolidJS', Icon: SolidIcon },
  { id: 'angular', label: 'Angular', Icon: AngularIcon },
  { id: 'astro', label: 'Astro', Icon: AstroIcon },
] as const;
const missingSlots = frameworks.filter(({ id }) => !Astro.slots.has(id)).map(({ id }) => id);
const presentCode = frameworks.filter(({ id }) => (codeMap[id] ?? '').trim());
const hasCode = presentCode.length > 0;
const missingCode = hasCode && presentCode.length < frameworks.length
  ? frameworks.filter(({ id }) => !(codeMap[id] ?? '').trim()).map(({ id }) => id)
  : [];
if (missingSlots.length || missingCode.length) {
  const details = [
    missingSlots.length ? `slots: ${missingSlots.join(', ')}` : '',
    missingCode.length ? `code: ${missingCode.join(', ')}` : '',
  ].filter(Boolean).join('; ');
  throw new Error(`FrameworkPreview "${title ?? 'example'}" is incomplete (${details})`);
}
const shikiThemes = { light: krdsShikiLight, dark: krdsShikiHighContrast };

const uid = previewId ?? `fp-${kind ? `${kind}-` : ''}${(title ?? 'example').toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-').replace(/^-+|-+$/g, '')}`;
---

<section class="framework-preview not-content" data-framework-preview data-kind={kind} data-title={title ?? ''}>
  {kind ? (
    <header class="practice-header">
      <span class="practice-badge">{kind === 'good' ? '모범 사례' : '피해야 할 사례'}</span>
      {title && <p class="practice-rule">{title}</p>}
    </header>
  ) : (
    <header class="preview-header">
      <p class="eyebrow">Framework native example</p>
      <h2>{title ?? 'Framework'} 구현 예제</h2>
    </header>
  )}

  {hasCode ? (
    <div class="preview-grid">
      <section class="source-pane" aria-label="소스 코드">
        <div class="pane-toolbar source-toolbar">
          <div class="framework-tabs" role="tablist" aria-label="프레임워크 선택" data-framework-tabs data-sync-key="framework">
            <button type="button" role="tab" id={`${uid}-react-tab`} aria-controls={`${uid}-react`} aria-selected="true" tabindex="0" data-framework="react"><ReactIcon class="tab-icon" /><span>React</span></button>
            <button type="button" role="tab" id={`${uid}-vue-tab`} aria-controls={`${uid}-vue`} aria-selected="false" tabindex="-1" data-framework="vue"><VueIcon class="tab-icon" /><span>Vue</span></button>
            <button type="button" role="tab" id={`${uid}-svelte-tab`} aria-controls={`${uid}-svelte`} aria-selected="false" tabindex="-1" data-framework="svelte"><SvelteIcon class="tab-icon" /><span>Svelte</span></button>
            <button type="button" role="tab" id={`${uid}-solid-tab`} aria-controls={`${uid}-solid`} aria-selected="false" tabindex="-1" data-framework="solid"><SolidIcon class="tab-icon" /><span>SolidJS</span></button>
            <button type="button" role="tab" id={`${uid}-angular-tab`} aria-controls={`${uid}-angular`} aria-selected="false" tabindex="-1" data-framework="angular"><AngularIcon class="tab-icon" /><span>Angular</span></button>
            <button type="button" role="tab" id={`${uid}-astro-tab`} aria-controls={`${uid}-astro`} aria-selected="false" tabindex="-1" data-framework="astro"><AstroIcon class="tab-icon" /><span>Astro</span></button>
          </div>
          <button type="button" class="quiet-action" data-copy-source>복사</button>
        </div>

        <div role="tabpanel" id={`${uid}-react`} aria-labelledby={`${uid}-react-tab`} class="source-panel" data-source-panel data-framework="react"><Code code={codeMap.react ?? ''} lang="tsx" themes={shikiThemes} defaultColor="light" /></div>
        <div role="tabpanel" id={`${uid}-vue`} aria-labelledby={`${uid}-vue-tab`} class="source-panel" data-source-panel data-framework="vue" hidden><Code code={codeMap.vue ?? ''} lang="vue" themes={shikiThemes} defaultColor="light" /></div>
        <div role="tabpanel" id={`${uid}-svelte`} aria-labelledby={`${uid}-svelte-tab`} class="source-panel" data-source-panel data-framework="svelte" hidden><Code code={codeMap.svelte ?? ''} lang="svelte" themes={shikiThemes} defaultColor="light" /></div>
        <div role="tabpanel" id={`${uid}-solid`} aria-labelledby={`${uid}-solid-tab`} class="source-panel" data-source-panel data-framework="solid" hidden><Code code={codeMap.solid ?? ''} lang="tsx" themes={shikiThemes} defaultColor="light" /></div>
        <div role="tabpanel" id={`${uid}-angular`} aria-labelledby={`${uid}-angular-tab`} class="source-panel" data-source-panel data-framework="angular" hidden><Code code={codeMap.angular ?? ''} lang="ts" themes={shikiThemes} defaultColor="light" /></div>
        <div role="tabpanel" id={`${uid}-astro`} aria-labelledby={`${uid}-astro-tab`} class="source-panel" data-source-panel data-framework="astro" hidden><Code code={codeMap.astro ?? ''} lang="astro" themes={shikiThemes} defaultColor="light" /></div>
      </section>

      <section class="preview-pane" aria-label="컴포넌트 미리보기">
        <div class="pane-toolbar preview-toolbar"><span>Preview</span></div>
        <p class="astro-note" data-astro-note hidden>Astro 컴포넌트는 정적 SSR로 렌더링됩니다 (반응형 island 아님).</p>
        <div class="preview-stage">
          <div class="preview-viewport" data-preview-panel data-framework="react"><slot name="react" /></div>
          <div class="preview-viewport" data-preview-panel data-framework="vue" hidden><slot name="vue" /></div>
          <div class="preview-viewport" data-preview-panel data-framework="svelte" hidden><slot name="svelte" /></div>
          <div class="preview-viewport" data-preview-panel data-framework="solid" hidden><slot name="solid" /></div>
          <div class="preview-viewport" data-preview-panel data-framework="angular" hidden><slot name="angular" /></div>
          <div class="preview-viewport" data-preview-panel data-framework="astro" hidden><slot name="astro" /></div>
        </div>
      </section>
    </div>
  ) : (
    <div class="preview-only">
      <div class="framework-tabs" role="tablist" aria-label="프레임워크 선택" data-framework-tabs data-sync-key="framework">
        <button type="button" role="tab" id={`${uid}-react-tab`} aria-controls={`${uid}-react`} aria-selected="true" tabindex="0" data-framework="react"><ReactIcon class="tab-icon" /><span>React</span></button>
        <button type="button" role="tab" id={`${uid}-vue-tab`} aria-controls={`${uid}-vue`} aria-selected="false" tabindex="-1" data-framework="vue"><VueIcon class="tab-icon" /><span>Vue</span></button>
        <button type="button" role="tab" id={`${uid}-svelte-tab`} aria-controls={`${uid}-svelte`} aria-selected="false" tabindex="-1" data-framework="svelte"><SvelteIcon class="tab-icon" /><span>Svelte</span></button>
        <button type="button" role="tab" id={`${uid}-solid-tab`} aria-controls={`${uid}-solid`} aria-selected="false" tabindex="-1" data-framework="solid"><SolidIcon class="tab-icon" /><span>SolidJS</span></button>
        <button type="button" role="tab" id={`${uid}-angular-tab`} aria-controls={`${uid}-angular`} aria-selected="false" tabindex="-1" data-framework="angular"><AngularIcon class="tab-icon" /><span>Angular</span></button>
        <button type="button" role="tab" id={`${uid}-astro-tab`} aria-controls={`${uid}-astro`} aria-selected="false" tabindex="-1" data-framework="astro"><AstroIcon class="tab-icon" /><span>Astro</span></button>
      </div>
      <p class="astro-note" data-astro-note hidden>Astro 컴포넌트는 정적 SSR로 렌더링됩니다 (반응형 island 아님).</p>
      <div class="preview-stage">
        <div class="preview-viewport" id={`${uid}-react`} data-preview-panel data-framework="react"><slot name="react" /></div>
        <div class="preview-viewport" id={`${uid}-vue`} data-preview-panel data-framework="vue" hidden><slot name="vue" /></div>
        <div class="preview-viewport" id={`${uid}-svelte`} data-preview-panel data-framework="svelte" hidden><slot name="svelte" /></div>
        <div class="preview-viewport" id={`${uid}-solid`} data-preview-panel data-framework="solid" hidden><slot name="solid" /></div>
        <div class="preview-viewport" id={`${uid}-angular`} data-preview-panel data-framework="angular" hidden><slot name="angular" /></div>
        <div class="preview-viewport" id={`${uid}-astro`} data-preview-panel data-framework="astro" hidden><slot name="astro" /></div>
      </div>
    </div>
  )}
</section>

<script>
  import '../scripts/framework-sync.ts';

  // Copy button: reads the currently visible source panel. Delegated so it
  // also covers tabsets added by Astro view transitions.
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-source]');
    if (!button) return;
    const root = button.closest<HTMLElement>('[data-framework-preview]');
    const active = root?.querySelector<HTMLElement>('[data-source-panel]:not([hidden])');
    if (!active) return;
    await navigator.clipboard.writeText(active.textContent ?? '');
    button.textContent = '복사됨';
    setTimeout(() => {
      button.textContent = '복사';
    }, 1200);
  });
</script>

<style>
  .framework-preview {
    margin-block: 2rem;
  }

  .preview-header {
    margin-bottom: 1rem;
  }

  .preview-header .eyebrow {
    margin-block-end: 0.25rem;
    color: var(--sl-color-text-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .preview-header h2 {
    margin: 0;
    color: var(--sl-color-text);
    font-size: 1.15rem;
  }

  /* 모범 사례 / 피해야 할 사례 헤더 */
  .practice-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--krds-mode-light-color-border-secondary-light);
  }

  .practice-badge {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
  }

  [data-kind='good'] .practice-badge {
    background: var(--krds-mode-light-color-semantic-success);
  }

  [data-kind='bad'] .practice-badge {
    background: var(--krds-mode-light-color-semantic-danger);
  }

  .practice-rule {
    margin: 0;
    font-size: 0.875rem;
    color: var(--krds-mode-light-color-text-basic);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--krds-mode-light-color-border-secondary-light);
    border-radius: 1rem;
    background: var(--krds-mode-light-color-background-white);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--krds-mode-light-color-text-basic) 10%, transparent);
  }

  @media (min-width: 60rem) {
    .preview-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .pane-toolbar {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-inline: 0.75rem 1rem;
    border-bottom: 1px solid var(--krds-mode-light-color-border-gray-light);
    background: var(--krds-mode-light-color-background-white);
    color: var(--krds-mode-light-color-text-basic);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .quiet-action {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    justify-content: center;
    padding-inline: 0.7rem;
    border: 1px solid var(--krds-mode-light-color-border-gray-light);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--krds-mode-light-color-text-subtle);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
  }

  .quiet-action:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .quiet-action:hover {
    border-color: var(--krds-mode-light-color-border-primary);
    color: var(--krds-mode-light-color-text-primary);
  }

  .astro-note {
    margin: 0;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--krds-mode-light-color-border-gray-light);
    background: var(--krds-mode-light-color-background-gray-subtle);
    color: var(--krds-mode-light-color-text-subtle);
    font-size: 0.78rem;
  }

  .source-panel {
    padding: 0;
  }

  .source-panel :global(figure) {
    margin: 0;
  }

  .source-panel :global(.astro-code) {
    min-height: 30rem;
    margin: 0;
    padding: 1.1rem 1.25rem 2rem;
    border: 0;
    overflow-x: auto;
    overflow-y: visible;
    font-size: 0.74rem;
    line-height: 1.65;
    tab-size: 2;
  }

  .preview-pane {
    border-top: 1px solid var(--krds-mode-light-color-border-gray-light);
    background: var(--krds-mode-light-color-background-gray-subtler);
  }

  @media (min-width: 60rem) {
    .preview-pane {
      border-top: 0;
      border-left: 1px solid var(--krds-mode-light-color-border-gray-light);
    }
  }

  .preview-toolbar span {
    color: var(--krds-mode-light-color-text-subtle);
    font-size: 0.72rem;
  }

  .preview-stage {
    display: flex;
    height: auto;
    min-height: 30rem;
    align-items: center;
    justify-content: center;
    overflow-x: auto;
    overflow-y: visible;
    padding: 1rem;
    background-image: radial-gradient(circle, color-mix(in srgb, #6b7280 26%, transparent) 0.7px, transparent 0.7px);
    background-size: 12px 12px;
    /* The inline KRDS demos size themselves for a 10px rem root, but the docs
       page keeps a 16px root (theme.css neutralizes the foundation's html
       rule). Zoom the stage back to the design scale. Layout containment also
       traps fixed-position demos (modal overlays) inside the stage instead of
       covering the whole viewport. */
    zoom: 0.625;
    contain: layout;
  }

  .preview-viewport:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    height: auto;
    min-height: 30rem;
    background: var(--krds-mode-light-color-background-white);
  }

  .preview-viewport:not([hidden]):empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-4);
    font-size: 0.875rem;
  }

  /* 데모 내 전체 폭 설명 문단 (검색 결과 없음 등) */
  .preview-viewport :global(p) {
    width: 100%;
    margin: 0;
  }

  /* 피해야 할 사례 예시가 원시 앵커로 렌더될 때 (인디케이터/밑줄 없음). */
  .preview-viewport :global(.practice-link-color-only) {
    color: var(--krds-light-color-link-default, var(--krds-mode-light-color-text-link, #256ef4));
    text-decoration: none;
  }

  .preview-viewport :global(.practice-link-plain) {
    color: var(--krds-mode-light-color-text-basic);
    text-decoration: none;
  }

  @media (max-width: 38rem) {
    .pane-toolbar {
      align-items: flex-start;
      flex-wrap: wrap;
      padding-block: 0.65rem;
    }

    .framework-tabs {
      width: 100%;
    }

    .source-panel :global(.astro-code),
    .preview-stage {
      min-height: 26rem;
    }

    .preview-stage {
      padding: 0.5rem;
    }
  }
</style>
