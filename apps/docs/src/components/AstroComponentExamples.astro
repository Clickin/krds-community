---
import {
  Accordion,
  AccordionLine,
  Badge,
  BadgeNumber,
  BadgeSize,
  Breadcrumb,
  Button,
  ButtonHierarchy,
  ButtonIcon,
  ButtonSize,
  ButtonText,
  ButtonWithIcon,
  Calendar,
  CalendarRange,
  Carousel,
  CarouselBanner,
  Checkbox,
  CheckboxChip,
  CheckboxSize,
  CoachMark,
  ContextualHelp,
  CriticalAlerts,
  DateInput,
  Disclosure,
  Favicon,
  FileUpload,
  Footer,
  Header,
  HelpPanel,
  Identifier,
  InPageNavigation,
  LanguageSwitcher,
  LanguageSwitcherPage,
  Link,
  MainMenuMobile,
  MainMenuPc,
  Masthead,
  Modal,
  ModalSample,
  Pagination,
  Radio,
  RadioButton,
  RadioChip,
  RadioSize,
  Resize,
  Select,
  SelectSize,
  SelectSorting,
  SelectState,
  SideNavigation,
  SkipLink,
  Spinner,
  StepIndicator,
  StructuredList,
  StructuredListTable,
  Switch,
  Tab,
  Table,
  Tag,
  TagLink,
  Textarea,
  TextInput,
  TextInputIcon,
  TextInputSize,
  TextInputState,
  TextList,
  TextListOrdered,
  ToggleSwitch,
  ToggleSwitchSize,
  Tooltip,
  TooltipBox,
  TooltipVertical,
  Tts,
  TtsIcon,
  TtsSize,
  TutorialPanel,
} from '@krds-community/astro';

const calendarProps = {
  year: 2026,
  month: 7,
  years: [2025, 2026, 2027],
  leadingDays: 3,
  previousMonthDayCount: 30,
  dayCount: 31,
  weekdays: ['일', '월', '화', '수', '목', '금', '토'],
  todayDay: 27,
  eventDays: [5, 18],
  disabledDays: [11],
};

const carouselSlides = [
  {
    id: 'service-guide',
    title: '온라인 서비스 안내',
    description: '민원 절차와 준비 서류를 확인하세요.',
    href: '/service-patterns/application/',
  },
];

const menuItems = [
  { id: 'guide', label: '서비스 안내', href: '/service-patterns/' },
  { id: 'components', label: '컴포넌트', href: '/components/' },
];

const languageOptions = [
  { value: 'ko', label: '한국어', href: '/components/astro-examples/', lang: 'ko' },
  { value: 'en', label: 'English', href: '/components/astro-examples/', lang: 'en' },
];

const panelTabs = [
  { id: 'help', label: '도움말', panelId: 'help-panel', value: 'help' },
  { id: 'tutorial', label: '튜토리얼', panelId: 'tutorial-panel', value: 'tutorial' },
];
const panelLinks = [{ label: '도움말 문서', href: '/guides/krds-guidelines/' }];
const panelGroups = [{ title: '관련 링크', links: panelLinks }];
const panelTasks = [
  { id: 'start', title: '시작하기', summary: '첫 단계를 확인합니다.', steps: ['서비스 목적 확인', '필수 정보 입력'], current: true },
];

const tableColumns = [
  { key: 'service', label: '서비스' },
  { key: 'status', label: '상태' },
];
const tableRows = [{ service: '신청서', status: '검토 중' }];
const structuredRows = [{ id: 'request', title: '신청서 검토', description: '처리 상태를 확인합니다.', href: '/service-patterns/application/', status: '검토 중' }];
const structuredColumns = [
  { key: 'title', label: '제목' },
  { key: 'status', label: '상태' },
];
const structuredPagination = {
  current: 1,
  items: [1, 2],
  previousLabel: '이전',
  nextLabel: '다음',
  currentLabel: '현재 페이지',
};
---

<section class="astro-example-section" aria-labelledby="astro-navigation-examples">
  <h2 id="astro-navigation-examples">탐색·레이아웃</h2>
  <p>각 예시는 <code>@krds-community/astro</code> public export를 직접 import하며, 입력한 props가 실제 상태와 의미를 결정합니다.</p>
  <div class="astro-example-grid">
    <article><h3>Breadcrumb</h3><Breadcrumb items={[{ id: 'home', label: '홈', href: '/' }, { id: 'current', label: '예제', href: '/components/astro-examples/', current: true }]} label="현재 위치" /></article>
    <article><h3>Header</h3><Header logoLabel="KRDS Community" logoHref="/" desktopItems={menuItems} nav={menuItems} searchLabel="검색" loginLabel="로그인" /></article>
    <article><h3>MainMenuPc</h3><MainMenuPc items={menuItems} navigationLabel="주 메뉴" menuLabel="메뉴" /></article>
    <article><h3>MainMenuMobile</h3><MainMenuMobile items={menuItems} navigationLabel="모바일 메뉴" /></article>
    <article><h3>SideNavigation</h3><SideNavigation title="문서 목차" items={[{ id: 'overview', label: '개요', href: '/components/', current: true }, { id: 'examples', label: '예제', href: '/components/astro-examples/' }]} navigationLabel="보조 탐색" /></article>
    <article><h3>InPageNavigation</h3><InPageNavigation title="이 페이지" pageTitle="Astro 예제" items={[{ id: 'overview', label: '개요', href: '#astro-navigation-examples', current: true }]} /></article>
    <article><h3>LanguageSwitcher</h3><LanguageSwitcher languages={languageOptions} selected="ko" label="언어" selectedLabel="선택됨" /></article>
    <article><h3>LanguageSwitcherPage</h3><LanguageSwitcherPage languages={languageOptions} selected="ko" label="언어별 페이지" selectedLabel="선택됨" /></article>
    <article><h3>Link</h3><Link href="/components/" label="컴포넌트 인벤토리" /></article>
    <article><h3>SkipLink</h3><SkipLink href="#main-content" label="본문으로 건너뛰기" /></article>
    <article><h3>Masthead</h3><Masthead message="서비스 이용 안내를 확인하세요." /></article>
    <article><h3>Identifier</h3><Identifier organization="KRDS Community" description="공공 서비스 컴포넌트 안내">서비스 식별자</Identifier></article>
    <article><h3>Footer</h3><Footer organization="KRDS Community" address="서울특별시" copyright="© KRDS Community" policyLinks={[{ label: '개인정보처리방침', href: '/guides/krds-guidelines/' }]} /></article>
    <article><h3>Favicon</h3><Favicon href="/favicon.svg" /></article>
  </div>
</section>

<section class="astro-example-section" aria-labelledby="astro-interaction-examples">
  <h2 id="astro-interaction-examples">동작·피드백</h2>
  <div class="astro-example-grid">
    <article><h3>Accordion</h3><Accordion items={[{ id: 'overview', title: '서비스 개요', content: '서비스 이용 방법을 확인합니다.' }]} defaultOpen={['overview']} /></article>
    <article><h3>AccordionLine</h3><AccordionLine items={[{ id: 'overview-line', title: '상세 안내', content: '선형 아코디언 상세 내용입니다.' }]} open={['overview-line']} /></article>
    <article><h3>Carousel</h3><Carousel slides={carouselSlides} previousLabel="이전" nextLabel="다음" moreLabel="전체 보기" actionLabel="자세히 보기" autoPlay={false} /></article>
    <article><h3>CarouselBanner</h3><CarouselBanner slides={carouselSlides} previousLabel="이전" nextLabel="다음" moreLabel="전체 보기" playLabel="재생" stopLabel="정지" autoPlay={false} /></article>
    <article><h3>CoachMark</h3><CoachMark title="서비스 둘러보기" step="1 / 3" stepTitle="첫 번째 단계" description="주요 메뉴를 확인하세요." currentStepLabel="현재 단계" totalStepsLabel="전체 단계" stopLabel="종료" nextLabel="다음" contentTitle="메뉴 안내" open /></article>
    <article><h3>ContextualHelp</h3><ContextualHelp label="도움말" caption="입력 방법" title="이름 입력" message="등록된 이름을 입력하세요." closeLabel="닫기" defaultOpen position="top-left" /></article>
    <article><h3>CriticalAlerts</h3><CriticalAlerts items={[{ id: 'maintenance', message: '시스템 점검 안내', tone: 'danger', badge: 'danger' }]} /></article>
    <article><h3>Disclosure</h3><Disclosure title="추가 안내" description="필요한 경우 내용을 펼쳐 확인하세요." open={false}>서비스 이용 시간은 평일 오전 9시부터 오후 6시까지입니다.</Disclosure></article>
    <article><h3>HelpPanel</h3><HelpPanel tabs={panelTabs} selectedLabel="선택됨" helpTitle="도움말" helpDescription="서비스 이용 방법입니다." downloadLinks={panelLinks} relatedGroups={panelGroups} tutorialTitle="튜토리얼" tasks={panelTasks} stopLabel="종료" collapseLabel="접기" label="도움말 열기" activeTab="help" /></article>
    <article><h3>TutorialPanel</h3><TutorialPanel tabs={panelTabs} selectedLabel="선택됨" helpTitle="도움말" helpDescription="서비스 이용 방법입니다." downloadLinks={panelLinks} relatedGroups={panelGroups} tutorialTitle="튜토리얼" tasks={panelTasks} stopLabel="종료" collapseLabel="접기" label="튜토리얼 열기" activeTab="tutorial" open /></article>
    <article><h3>Modal</h3><Modal title="신청서 제출" description="입력한 내용을 제출하시겠습니까?" cancelLabel="취소" confirmLabel="확인" closeLabel="닫기" triggerLabel="제출 확인" open /></article>
    <article><h3>ModalSample</h3><ModalSample title="안내" description="샘플 모달입니다." cancelLabel="취소" confirmLabel="확인" closeLabel="닫기" triggerLabel="안내 열기" /></article>
    <article><h3>Pagination</h3><Pagination items={[1, 2, 3, 'ellipsis', 8]} current={2} previousLabel="이전" nextLabel="다음" /></article>
    <article><h3>Resize</h3><Resize options={[{ value: 'small', label: '작게' }, { value: 'medium', label: '보통' }, { value: 'large', label: '크게' }]} selected="medium" label="화면 보기" /></article>
    <article><h3>Spinner</h3><Spinner label="처리 중" /></article>
    <article><h3>Tooltip</h3><Tooltip label="용어 설명" message="공공 서비스 이용에 필요한 설명입니다." placement="horizontal" /></article>
    <article><h3>TooltipBox</h3><TooltipBox label="상자형 설명" message="상세 설명을 확인하세요." /></article>
    <article><h3>TooltipVertical</h3><TooltipVertical label="세로 설명" message="세로 배치 설명입니다." /></article>
  </div>
</section>

<section class="astro-example-section" aria-labelledby="astro-form-examples">
  <h2 id="astro-form-examples">입력·폼 상태</h2>
  <div class="astro-example-grid">
    <article><h3>Calendar</h3><Calendar {...calendarProps} label="날짜" hint="날짜를 선택하세요." /></article>
    <article><h3>CalendarRange</h3><CalendarRange {...calendarProps} label="기간" rangeStartDay={10} rangeEndDay={15} startName="start" endName="end" /></article>
    <article><h3>DateInput</h3><DateInput {...calendarProps} name="date" label="날짜" required /></article>
    <article><h3>Checkbox</h3><Checkbox id="terms" name="terms" label="약관에 동의합니다" /></article>
    <article><h3>CheckboxChip</h3><CheckboxChip id="filter-news" name="filter" label="새 소식" checked /></article>
    <article><h3>CheckboxSize</h3><CheckboxSize id="large-check" name="size" label="큰 체크박스" size="large" /></article>
    <article><h3>FileUpload</h3><FileUpload name="attachment" title="첨부 파일" description="파일을 선택하세요." prompt="10MB 이하 파일" selectLabel="파일 선택" files={[{ id: 'guide', name: 'guide.pdf', status: 'complete', statusLabel: '업로드 완료' }]} /></article>
    <article><h3>Radio</h3><Radio id="basic" name="plan" value="basic" label="기본" checked /></article>
    <article><h3>RadioButton</h3><RadioButton id="detail" name="view" value="detail" label="상세 보기" /></article>
    <article><h3>RadioChip</h3><RadioChip id="online" name="channel" value="online" label="온라인" checked /></article>
    <article><h3>RadioSize</h3><RadioSize id="large-radio" name="density" value="large" label="큰 라디오" size="large" /></article>
    <article><h3>Select</h3><Select name="service" label="서비스" options={[{ value: 'all', label: '전체' }, { value: 'application', label: '신청' }]} value="all" /></article>
    <article><h3>SelectSize</h3><SelectSize name="size-select" label="크기" options={[{ value: 'large', label: '큰 목록' }]} size="large" /></article>
    <article><h3>SelectSorting</h3><SelectSorting name="sort" label="정렬" options={[{ value: 'recent', label: '최신순' }]} value="recent" /></article>
    <article><h3>SelectState</h3><SelectState name="state-select" label="상태" options={[{ value: 'required', label: '선택' }]} state="error" /></article>
    <article><h3>Switch</h3><Switch id="notifications" name="notifications" label="알림 받기" checked /></article>
    <article><h3>TextInput</h3><TextInput id="name" name="name" label="이름" hint="실명을 입력하세요." required /></article>
    <article><h3>TextInputIcon</h3><TextInputIcon id="search" name="search" label="검색" clearable /></article>
    <article><h3>TextInputSize</h3><TextInputSize id="large-input" name="large-input" label="큰 입력" size="large" /></article>
    <article><h3>TextInputState</h3><TextInputState id="invalid" name="invalid" label="이메일" state="error" error="이메일 형식을 확인하세요." /></article>
    <article><h3>Textarea</h3><Textarea id="reason" name="reason" label="신청 사유" hint="내용을 입력하세요." required /></article>
    <article><h3>ToggleSwitch</h3><ToggleSwitch id="privacy" name="privacy" label="공개 설정" /></article>
    <article><h3>ToggleSwitchSize</h3><ToggleSwitchSize id="large-toggle" name="large-toggle" label="큰 토글" size="large" checked /></article>
  </div>
</section>

<section class="astro-example-section" aria-labelledby="astro-content-examples">
  <h2 id="astro-content-examples">콘텐츠·표현 상태</h2>
  <div class="astro-example-grid">
    <article><h3>Badge</h3><Badge label="진행 중" tone="primary" /></article>
    <article><h3>BadgeNumber</h3><BadgeNumber label={3} tone="information" /></article>
    <article><h3>BadgeSize</h3><BadgeSize label="새 소식" size="large" /></article>
    <article><h3>Button</h3><Button label="저장" variant="primary" type="submit" /></article>
    <article><h3>ButtonHierarchy</h3><ButtonHierarchy label="보조 작업" variant="secondary" /></article>
    <article><h3>ButtonIcon</h3><ButtonIcon label="검색" iconClass="ico-sch" /></article>
    <article><h3>ButtonSize</h3><ButtonSize label="큰 작업" size="large" /></article>
    <article><h3>ButtonText</h3><ButtonText label="더 보기" variant="tertiary" /></article>
    <article><h3>ButtonWithIcon</h3><ButtonWithIcon label="다운로드" iconClass="ico-down" /></article>
    <article><h3>StepIndicator</h3><StepIndicator steps={[{ id: 'one', label: '신청 정보' }, { id: 'two', label: '확인' }, { id: 'three', label: '완료' }]} current={2} label="신청 단계" /></article>
    <article><h3>StructuredList</h3><StructuredList items={structuredRows} dateLabel="등록일" dateValue="2026-07-27" tags={['민원']} actionLabel="상세 보기" shareLabel="공유" favoriteLabel="즐겨찾기" /></article>
    <article><h3>StructuredListTable</h3><StructuredListTable columns={structuredColumns} rows={[{ id: 'request', title: '신청서 검토', status: '검토 중', selected: true }]} caption="신청 목록" selectAllLabel="전체 선택" actions={[{ id: 'download', label: '다운로드' }]} countLabel="표시 개수" countOptions={['10', '20']} sortLabel="정렬" sortOptions={['최신순']} sortValue="최신순" pagination={structuredPagination} /></article>
    <article><h3>Tab</h3><Tab tabs={[{ id: 'summary', label: '요약' }, { id: 'details', label: '상세' }]} panels={{ summary: '서비스 요약', details: '서비스 상세' }} defaultValue="summary" /></article>
    <article><h3>Table</h3><Table columns={tableColumns} rows={tableRows} caption="서비스 상태" /></article>
    <article><h3>Tag</h3><Tag label="민원" message="민원 필터 제거" removeLabel="민원 필터 제거" removable /></article>
    <article><h3>TagLink</h3><TagLink href="/service-patterns/" label="서비스 패턴" /></article>
    <article><h3>TextList</h3><TextList items={['첫 번째 안내', { id: 'second', label: '두 번째 안내', children: ['세부 항목'] }]} /></article>
    <article><h3>TextListOrdered</h3><TextListOrdered items={['정보 입력', '내용 확인', '제출 완료']} ordered /></article>
    <article><h3>Tts</h3><Tts text="서비스 이용 안내" label="읽어주기" /></article>
    <article><h3>TtsIcon</h3><TtsIcon text="서비스 이용 안내" label="읽어주기" /></article>
    <article><h3>TtsSize</h3><TtsSize text="서비스 이용 안내" label="큰 읽어주기" size="large" /></article>
  </div>
</section>
