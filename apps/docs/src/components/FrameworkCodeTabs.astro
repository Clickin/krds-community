---
import { Code } from 'astro:components';
import { krdsShikiHighContrast, krdsShikiLight } from '../theme/krds-shiki';
import '../styles/framework-tabs.css';
import AngularIcon from './icons/AngularIcon.astro';
import AstroIcon from './icons/AstroIcon.astro';
import ReactIcon from './icons/ReactIcon.astro';
import SolidIcon from './icons/SolidIcon.astro';
import SvelteIcon from './icons/SvelteIcon.astro';
import VueIcon from './icons/VueIcon.astro';

type FrameworkCodeLanguage = 'tsx' | 'vue' | 'svelte' | 'ts' | 'astro';
type FrameworkCode = {
  framework: string;
  label: string;
  language: FrameworkCodeLanguage;
  code: string;
};

type Props = { examples: FrameworkCode[]; title?: string };
const { examples, title } = Astro.props;

const frameworkIcons = {
  react: ReactIcon,
  vue: VueIcon,
  svelte: SvelteIcon,
  solid: SolidIcon,
  angular: AngularIcon,
  astro: AstroIcon,
} as const;

const shikiThemes = { light: krdsShikiLight, dark: krdsShikiHighContrast };
const uid = `code-${title?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'tabs'}`;
---

<div class="framework-code-tabs not-content" data-code-tabs data-title={title || ''}>
  <div class="tabs-header">
    <div class="framework-tabs" role="tablist" aria-label="프레임워크 선택" data-framework-tabs data-sync-key="framework">
      {examples.map((example, index) => {
        const Icon = frameworkIcons[example.framework as keyof typeof frameworkIcons] || ReactIcon;
        const selected = index === 0;
        return (
          <button
            type="button"
            role="tab"
            id={`${uid}-${example.framework}-tab`}
            aria-controls={`${uid}-${example.framework}`}
            aria-selected={selected ? 'true' : 'false'}
            tabindex={selected ? 0 : -1}
            data-framework={example.framework}
          >
            <Icon class="tab-icon" />
            <span>{example.label}</span>
          </button>
        );
      })}
    </div>
  </div>
  {examples.map((example, index) => (
    <div
      role="tabpanel"
      id={`${uid}-${example.framework}`}
      aria-labelledby={`${uid}-${example.framework}-tab`}
      class="code-panel"
      data-code-panel
      data-framework={example.framework}
      hidden={index !== 0}
    >
      <Code
        code={example.code}
        lang={example.language}
        themes={shikiThemes}
        defaultColor="light"
      />
    </div>
  ))}
</div>

<script>
  import '../scripts/framework-sync.ts';
</script>

<style>
  .framework-code-tabs {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.85rem;
    overflow: hidden;
  }
  .tabs-header {
    background: var(--sl-color-bg-nav);
  }
  .code-panel {
    padding: 0;
  }
  .code-panel :global(pre) {
    margin: 0;
    border-radius: 0;
  }
</style>