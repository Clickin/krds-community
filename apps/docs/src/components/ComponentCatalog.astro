---
import { componentNavigation } from '../data/component-meta';
const base = import.meta.env.BASE_URL;
---

<section class="component-catalog not-content" data-component-catalog>
  <label class="catalog-search">
    <span>컴포넌트 찾기</span>
    <input type="search" placeholder="이름 또는 ID 검색" autocomplete="off" data-catalog-query />
  </label>
  <p class="catalog-count"><strong data-catalog-count>{componentNavigation.length}</strong>개 컴포넌트</p>
  <div class="catalog-grid">
    {
      componentNavigation.map((component) => (
        <a
          href={`${base}components/${component.category}/${component.id}/`}
          class="catalog-item"
          data-catalog-item
          data-search={`${component.title} ${component.id}`}
        >
          <span class="catalog-id">{component.id}</span>
          <strong>{component.title}</strong>
          <span class="catalog-meta">6개 프레임워크 · 소스 + 실행 미리보기</span>
        </a>
      ))
    }
  </div>
  <p class="catalog-empty" hidden data-catalog-empty>일치하는 컴포넌트가 없습니다.</p>
</section>

<script>
  const initializeCatalog = (root: HTMLElement) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const input = root.querySelector<HTMLInputElement>('[data-catalog-query]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-catalog-item]'));
    const count = root.querySelector<HTMLElement>('[data-catalog-count]');
    const empty = root.querySelector<HTMLElement>('[data-catalog-empty]');
    if (!input || !count || !empty) return;
    input.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('ko-KR');
      let visible = 0;
      items.forEach((item) => {
        const matches = !query || item.dataset.search?.includes(query) === true;
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      count.textContent = String(visible);
      empty.hidden = visible > 0;
    });
  };
  document.querySelectorAll<HTMLElement>('[data-component-catalog]').forEach(initializeCatalog);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-component-catalog]').forEach(initializeCatalog);
  });
</script>

<style>
  .component-catalog {
    margin-top: 1.5rem;
  }

  .catalog-search {
    display: grid;
    max-width: 34rem;
    gap: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .catalog-search input {
    min-height: 3.1rem;
    padding-inline: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.7rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .catalog-search input:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .catalog-count {
    margin-block: 1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
  }

  .catalog-grid a {
    display: flex;
    min-height: 9rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.8rem;
    background: linear-gradient(150deg, var(--sl-color-bg-nav), var(--sl-color-bg));
    color: var(--sl-color-text);
    text-decoration: none;
    transition: border-color 140ms ease, transform 140ms ease;
  }

  .catalog-grid a:hover {
    border-color: var(--sl-color-accent-high);
    transform: translateY(-2px);
  }

  .catalog-grid a[hidden] {
    display: none;
  }

  .catalog-id {
    margin-bottom: auto;
    color: var(--sl-color-text-accent);
    font-family: var(--__sl-font-mono);
    font-size: 0.7rem;
  }

  .catalog-grid strong {
    font-size: 1.05rem;
  }

  .catalog-meta {
    margin-top: 0.3rem;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
  }

  .catalog-empty {
    padding-block: 3rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-grid a {
      transition: none;
    }
  }
</style>
