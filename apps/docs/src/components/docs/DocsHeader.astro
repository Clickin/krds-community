---
import { withBase } from '../../data/links';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href={withBase('/')} aria-label="KRDS Community 홈">KRDS Community</a>
    <nav class="site-nav" aria-label="주요 문서">
      <a class:list={{ current: currentPath.includes('/components') }} href={withBase('/components/')}>컴포넌트</a>
      <a class:list={{ current: currentPath.includes('/service-patterns') }} href={withBase('/service-patterns/')}>서비스 패턴</a>
      <a class:list={{ current: currentPath.includes('/basic-patterns') }} href={withBase('/basic-patterns/')}>기본 패턴</a>
      <a class:list={{ current: currentPath.includes('/framework-examples') }} href={withBase('/framework-examples/')}>프레임워크 예제</a>
    </nav>
    <div class="site-actions">
      <a href={withBase('/storybook/')}>Storybook</a>
      <a href={withBase('/conformance-report/')}>Conformance</a>
      <button type="button" data-theme-toggle aria-label="색상 테마 전환">테마</button>
      <button type="button" class="site-menu-toggle" aria-expanded="false" aria-controls="site-mobile-nav">메뉴</button>
    </div>
  </div>
  <nav id="site-mobile-nav" class="site-mobile-nav" aria-label="모바일 문서 메뉴" hidden>
    <a href={withBase('/components/')}>컴포넌트</a>
    <a href={withBase('/service-patterns/')}>서비스 패턴</a>
    <a href={withBase('/basic-patterns/')}>기본 패턴</a>
    <a href={withBase('/framework-examples/')}>프레임워크 예제</a>
    <a href={withBase('/storybook/')}>Storybook</a>
    <a href={withBase('/conformance-report/')}>Conformance</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-mobile-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    if (menu) menu.hidden = expanded;
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('krds-docs-theme', next);
  });

  const savedTheme = localStorage.getItem('krds-docs-theme');
  if (savedTheme) document.documentElement.dataset.theme = savedTheme;
</script>
