---
/* ---------------------------------------------------------------------------
 * PracticeExample — 모범 사례 / 피해야 할 사례 라이브 예시.
 *
 * MDX에서 사용:
 *
 *   <PracticeExample kind="good" title="한 페이지에 최상위 수준의 강조 버튼은 한 번만 사용한다.">
 *     <div slot="react">
 *       <ReactButton variant="primary">확인</ReactButton>
 *       <ReactButton variant="secondary">취소</ReactButton>
 *     </div>
 *     <div slot="vue">…</div>
 *     … (vue/svelte/solid/angular/astro)
 *   </PracticeExample>
 *
 * FrameworkPreview와 동일한 프레임워크 선택 상태(로컬스토리지)를 공유한다.
 * 코드 패널 없이 미리보기만 렌더하며, slot이 없는 프레임워크는 탭에서 제외된다.
 * --------------------------------------------------------------------------- */

import { Code } from 'astro:components';
import { krdsShikiHighContrast, krdsShikiLight } from '../theme/krds-shiki';
import AngularIcon from './icons/AngularIcon.astro';
import AstroIcon from './icons/AstroIcon.astro';
import ReactIcon from './icons/ReactIcon.astro';
import SolidIcon from './icons/SolidIcon.astro';
import SvelteIcon from './icons/SvelteIcon.astro';
import VueIcon from './icons/VueIcon.astro';

export type PracticeFramework = 'react' | 'vue' | 'svelte' | 'solid' | 'angular' | 'astro';

export interface Props {
  kind: 'good' | 'bad';
  title?: string;
  /** remark 플러그인이 주입한 코드 객체 (fw= 코드 블록) */
  code?: Partial<Record<PracticeFramework, string>>;
}

const { kind, title, code: codeMap = {} } = Astro.props;
const frameworks = [
  { id: 'react', label: 'React', Icon: ReactIcon },
  { id: 'vue', label: 'Vue', Icon: VueIcon },
  { id: 'svelte', label: 'Svelte', Icon: SvelteIcon },
  { id: 'solid', label: 'SolidJS', Icon: SolidIcon },
  { id: 'angular', label: 'Angular', Icon: AngularIcon },
  { id: 'astro', label: 'Astro', Icon: AstroIcon },
] as const;
const available = frameworks.filter(({ id }) => Astro.slots.has(id));
const langMap = {
  react: 'tsx',
  vue: 'vue',
  svelte: 'svelte',
  solid: 'tsx',
  angular: 'ts',
  astro: 'astro',
} as const;
const hasCode = available.some(({ id }) => (codeMap[id] ?? '').trim().length > 0);
const shikiThemes = { light: krdsShikiLight, dark: krdsShikiHighContrast };
const uid = `pe-${kind}-${(title ?? 'example').toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-').replace(/^-+|-+$/g, '')}`;
---

<section class="practice-example not-content" data-practice-example data-kind={kind} data-title={title ?? ''}>
  <header class="practice-header">
    <span class="practice-badge">{kind === 'good' ? '모범 사례' : '피해야 할 사례'}</span>
    {title && <p class="practice-rule">{title}</p>}
  </header>

  {available.length > 1 && (
    <div class="framework-tabs" role="tablist" aria-label="프레임워크 선택">
      {available.map(({ id, label, Icon }, index) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-${id}-tab`}
          aria-controls={`${uid}-${id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-framework={id}
        >
          <Icon class="tab-icon" />
          <span>{label}</span>
        </button>
      ))}
    </div>
  )}

  <div class="practice-stage">
    {available.map(({ id }, index) => (
      <div
        role="tabpanel"
        id={`${uid}-${id}`}
        aria-labelledby={`${uid}-${id}-tab`}
        class="practice-panel"
        data-practice-panel
        data-framework={id}
        hidden={index !== 0}
      >
        <slot name={id} />
      </div>
    ))}
  </div>

  {hasCode && (
    <div class="practice-code">
      {available.map(({ id }, index) => (
        <div
          role="tabpanel"
          id={`${uid}-${id}-code`}
          aria-labelledby={`${uid}-${id}-tab`}
          class="practice-code-panel"
          data-code-panel
          data-framework={id}
          hidden={index !== 0}
        >
          <Code code={codeMap[id] ?? ''} lang={langMap[id]} themes={shikiThemes} defaultColor="light" />
        </div>
      ))}
    </div>
  )}
</section>

<script>
  const STORAGE_KEY = 'krds-community:docs:framework';
  const readStored = () => {
    try {
      return window.localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };
  const writeStored = (fw: string) => {
    try {
      window.localStorage.setItem(STORAGE_KEY, fw);
    } catch {}
  };
  const selectFramework = (root: HTMLElement, framework: string) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"][data-framework]'));
    const target = tabs.find((t) => t.dataset.framework === framework);
    if (!target) return false;
    tabs.forEach((t) => {
      const selected = t === target;
      t.setAttribute('aria-selected', String(selected));
      t.tabIndex = selected ? 0 : -1;
    });
    root.dataset.framework = framework;
    root.querySelectorAll<HTMLElement>('[data-practice-panel]').forEach((p) => {
      p.hidden = p.dataset.framework !== framework;
    });
    root.querySelectorAll<HTMLElement>('[data-code-panel]').forEach((p) => {
      p.hidden = p.dataset.framework !== framework;
    });
    return true;
  };
  const applyAll = (framework: string) => {
    document
      .querySelectorAll<HTMLElement>('[data-practice-example], [data-framework-preview]')
      .forEach((root) => selectFramework(root, framework));
  };
  const initialize = (root: HTMLElement) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"][data-framework]'));
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        const framework = tab.dataset.framework;
        if (framework) {
          applyAll(framework);
          writeStored(framework);
        }
      });
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? tabs.length - 1
              : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        const target = tabs[next];
        const framework = target?.dataset.framework;
        if (target && framework) {
          target.focus();
          applyAll(framework);
          writeStored(framework);
        }
      });
    });
    const stored = readStored();
    const available = tabs.map((t) => t.dataset.framework).filter(Boolean) as string[];
    if (stored && available.includes(stored)) selectFramework(root, stored);
  };
  const initAll = () => {
    document.querySelectorAll<HTMLElement>('[data-practice-example]').forEach(initialize);
  };
  if (document.documentElement.dataset.krdsFrameworkSync !== 'true') {
    document.documentElement.dataset.krdsFrameworkSync = 'true';
    window.addEventListener('storage', (event) => {
      if (event.key === STORAGE_KEY && event.newValue) applyAll(event.newValue);
    });
  }
  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  .practice-example {
    margin-block: 1.25rem 2rem;
    border: 1px solid var(--krds-mode-light-color-border-secondary-light);
    border-radius: 1rem;
    background: var(--krds-mode-light-color-background-white);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--krds-mode-light-color-text-basic) 10%, transparent);
    overflow: hidden;
  }

  .practice-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--krds-mode-light-color-border-secondary-light);
  }

  .practice-badge {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
  }

  [data-kind='good'] .practice-badge {
    background: var(--krds-mode-light-color-semantic-success);
  }

  [data-kind='bad'] .practice-badge {
    background: var(--krds-mode-light-color-semantic-danger);
  }

  .practice-rule {
    margin: 0;
    font-size: 0.875rem;
    color: var(--krds-mode-light-color-text-basic);
  }

  .framework-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.625rem 1rem 0;
  }

  .framework-tabs [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 0;
    border-radius: 0.5rem 0.5rem 0 0;
    background: transparent;
    color: var(--krds-mode-light-color-text-subtle);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .framework-tabs [role='tab']:hover {
    color: var(--krds-mode-light-color-text-basic);
  }

  .framework-tabs [role='tab'][aria-selected='true'] {
    background: var(--krds-mode-light-color-surface-secondary);
    color: var(--krds-mode-light-color-text-basic);
  }

  .tab-icon {
    width: 1rem;
    height: 1rem;
  }

  .practice-stage {
    display: flex;
    align-items: center;
    min-height: 5rem;
    padding: 1.5rem;
    background: var(--krds-mode-light-color-surface-secondary-subtle, var(--krds-mode-light-color-background-subtle));
  }

  .practice-panel:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .practice-panel p {
    width: 100%;
    margin: 0;
  }

  .practice-code {
    border-top: 1px solid var(--krds-mode-light-color-border-secondary-light);
  }

  .practice-code-panel {
    padding: 0;
  }

  .practice-code-panel :global(pre) {
    margin: 0;
    border-radius: 0;
  }

  /* Anti-pattern examples rendered as raw anchors (no indicator/underline). */
  .practice-panel :global(.practice-link-color-only) {
    color: var(--krds-light-color-link-default, var(--krds-mode-light-color-text-link, #256ef4));
    text-decoration: none;
  }

  .practice-panel :global(.practice-link-plain) {
    color: var(--krds-mode-light-color-text-basic);
    text-decoration: none;
  }
</style>
