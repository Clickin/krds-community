---
import PatternExplorer from './PatternExplorer.astro';
import { findPattern } from '../data/patterns';

const { patternId } = Astro.props as { patternId: string };
const pattern = findPattern(patternId);
---

<header class="pattern-page-intro">
  <p class="pattern-eyebrow">{pattern.category}</p>
  <h2>{pattern.title}</h2>
  <p class="pattern-lede">{pattern.description}</p>
</header>

<section class="pattern-guidance" aria-labelledby={`${pattern.id}-guidance-title`}>
  <h2 id={`${pattern.id}-guidance-title`}>이 패턴의 사용 맥락</h2>
  <p>아래 예시는 공식 KRDS 패턴의 목적과 과업 흐름을 보여주는 검토용 시작점입니다. 한 문단의 최소 예시가 전체 guidance를 대체하지 않으므로, 제품에 적용할 때는 아래 공식 개요·단계·체크리스트와 서비스 맥락을 함께 검토하세요.</p>
  <dl class="pattern-guidance-links">
    <div><dt>공식 개요</dt><dd><a href={pattern.officialOverview} target="_blank" rel="noreferrer">원문 개요 확인</a></dd></div>
    <div><dt>적용 수준 체크리스트</dt><dd><a href={pattern.officialChecklist} target="_blank" rel="noreferrer">공식 체크리스트 확인</a></dd></div>
    <div><dt>버전 경계</dt><dd>{pattern.officialVersionBoundary}</dd></div>
  </dl>
  <h3>공식 단계·사례 링크</h3>
  <ul class="pattern-source-links">
    {pattern.officialStageLinks.map((stage) => <li><a href={stage.href} target="_blank" rel="noreferrer">{stage.title}</a></li>)}
  </ul>
</section>

<PatternExplorer pattern={pattern} />
