{
  "name": "krds-community",
  "private": true,
  "description": "KRDS를 프레임워크 네이티브 방식으로 구현하는 커뮤니티 모노레포.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/copy-notices.mjs",
    "lint": "pnpm lint:oxide && pnpm lint:react-compiler && pnpm lint:packages",
    "lint:oxide": "oxlint .",
    "lint:react-compiler": "eslint packages/react/src",
    "lint:packages": "pnpm -r lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:unit && pnpm test:reactivity && pnpm test:ssr",
    "test:unit": "vitest run tests/*.test.ts",
    "test:reactivity": "vitest run tests/framework/react.test.tsx tests/framework/vue.test.ts tests/framework/svelte.test.ts tests/framework/solid.test.tsx tests/framework/angular.test.ts tests/framework/svelte-presets.test.ts",
    "test:ssr": "vitest run tests/framework/ssr-hydration",
    "test:browser": "playwright test",
    "conformance:build": "pnpm --filter @krds-community/conformance --filter @krds-community/recipes --filter @krds-community/react --filter @krds-community/vue --filter @krds-community/svelte --filter @krds-community/solid --filter @krds-community/angular --filter @krds-community/astro build && pnpm --filter @krds-community/conformance-host build && pnpm --filter @krds-community/conformance-host-astro build",
    "conformance:run": "node scripts/conformance/parallel.mjs",
    "conformance:run:framework": "node scripts/conformance/runtime.mjs",
    "test:conformance:fixture": "pnpm conformance:build && pnpm conformance:run:framework --",
    "test:conformance:runtime": "pnpm conformance:build && pnpm conformance:run --output reports/conformance-runtime.json",
    "test:conformance": "pnpm test:conformance:runtime && node packages/conformance/dist/cli.js report --evidence reports/conformance-runtime.json --format markdown && node packages/conformance/dist/cli.js check --evidence reports/conformance-runtime.json --strict",
    "test:conformance:strict": "pnpm test:conformance",
    "test:storybook:audit": "pnpm --filter @krds-community/conformance build && node scripts/storybook-audit.mjs",
    "test:visual": "playwright test --project=chromium",
    "test:packages": "node scripts/check-packages.mjs",
    "publint": "node scripts/check-packages.mjs",
    "changeset:status": "node scripts/changeset-status.mjs",
    "krds": "node packages/cli/dist/cli.mjs",
    "tokens:generate": "node packages/tokens/scripts/generate.mjs",
    "upstream:check": "node scripts/upstream.mjs check",
    "upstream:sync": "node scripts/upstream.mjs sync",
    "upstream:diff": "node scripts/upstream.mjs diff",
    "upstream:extract": "node scripts/upstream.mjs extract",
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:build": "pnpm --filter @krds-community/docs build",
    "pages:build": "pnpm docs:build && pnpm storybook:build && pnpm --filter @krds-community/conformance-viewer build && node scripts/pages.mjs",
    "storybook": "node scripts/storybook.mjs dev",
    "storybook:build": "node scripts/storybook.mjs build"
  },
  "catalogs": {
    "default": {
      "@angular/common": "22.0.8",
      "@angular/cli": "22.0.8",
      "@angular/compiler": "22.0.8",
      "@angular/core": "22.0.8",
      "@angular/forms": "22.0.8",
      "@angular/platform-browser": "22.0.8",
      "@angular/platform-browser-dynamic": "22.0.8",
      "@astrojs/react": "6.0.1",
      "@astrojs/solid-js": "7.0.1",
      "@astrojs/svelte": "9.0.1",
      "@astrojs/starlight": "0.41.4",
      "@astrojs/vue": "7.0.1",
      "astro": "7.1.3",
      "@playwright/test": "1.62.0",
      "@testing-library/dom": "10.4.1",
      "@types/node": "26.1.1",
      "@analogjs/astro-angular": "2.6.4",
      "@angular/animations": "22.0.8",
      "@angular/build": "22.0.8",
      "@angular/compiler-cli": "22.0.8",
      "@angular/language-service": "22.0.8",
      "@angular/platform-server": "22.0.8",
      "rxjs": "7.8.2",
      "tslib": "2.8.1",
      "@storybook/angular": "10.5.4",
      "@storybook/html-vite": "10.5.4",
      "@storybook/svelte-vite": "10.5.4",
      "@storybook/vue3-vite": "10.5.4",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "6.0.4",
      "@storybook/react-vite": "10.5.4",
      "@storybook/addon-a11y": "10.5.4",
      "storybook": "10.5.4",
      "@vitejs/plugin-vue": "6.0.8",
      "@vitest/coverage-v8": "4.1.10",
      "angular": "1.8.3",
      "@changesets/cli": "2.31.1",
      "jsdom": "29.1.1",
      "oxfmt": "0.60.0",
      "oxlint": "1.75.0",
      "playwright": "1.62.0",
      "prettier": "3.9.6",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "solid-js": "1.9.14",
      "svelte": "5.56.7",
      "tailwindcss": "4.3.3",
      "typescript": "6.0.3",
      "vite": "8.1.5",
      "vitest": "4.1.10",
      "vue": "3.5.40"
    }
  },
  "devDependencies": {
    "@angular/cli": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-browser-dynamic": "catalog:",
    "@angular/platform-server": "catalog:",
    "@changesets/cli": "catalog:",
    "@krds-community/angular": "workspace:*",
    "@krds-community/react": "workspace:*",
    "@krds-community/recipes": "workspace:*",
    "@krds-community/solid": "workspace:*",
    "@krds-community/styles": "workspace:*",
    "@krds-community/svelte": "workspace:*",
    "@krds-community/tokens": "workspace:*",
    "@krds-community/vue": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/angular": "catalog:",
    "@storybook/html-vite": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/svelte-vite": "catalog:",
    "@storybook/vue3-vite": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pixelmatch": "catalog:",
    "playwright": "catalog:",
    "pngjs": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "storybook": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "yaml": "catalog:"
  }
}
