{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krds-community.dev/schemas/conformance-erratum.json",
  "title": "KRDS accessibility erratum",
  "type": "object",
  "required": [
    "id",
    "component",
    "upstream",
    "defect",
    "correction",
    "fixtures",
    "normalization",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^errata\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
    "component": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "upstream": {
      "type": "object",
      "required": ["version", "files"],
      "properties": {
        "version": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^upstream/" }
        }
      },
      "additionalProperties": false
    },
    "defect": {
      "type": "object",
      "required": ["type", "literalSource"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "literalSource": {
          "type": "object",
          "required": ["selectors", "behavior"],
          "properties": {
            "selectors": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "behavior": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": ["behavior", "attributes"],
      "properties": {
        "behavior": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["selector", "attribute", "rule"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
            "attribute": {
              "type": "string",
              "pattern": "^(?:aria-[a-z0-9-]+|role|hidden|id|data-listener-attached|onclick)$"
            },
              "rule": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "normalization": {
      "type": "object",
      "required": ["whitelist"],
      "properties": {
        "whitelist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["selector", "attribute", "rule"],
                "properties": {
                  "selector": { "type": "string", "minLength": 1 },
                  "attribute": {
                    "type": "string",
                    "pattern": "^(?:aria-[a-z0-9-]+|role|hidden|id|tabindex|href|data-listener-attached|onclick)$"
                  },
                  "rule": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["selector", "attribute", "operation", "value"],
                "properties": {
                  "selector": { "type": "string", "minLength": 1 },
                  "attribute": {
                    "type": "string",
                    "pattern": "^(?:aria-[a-z0-9-]+|role|hidden|id|tabindex|href|data-listener-attached|onclick)$"
                  },
                  "operation": { "const": "rewrite" },
                  "value": { "type": ["string", "number", "boolean"] }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["selector", "attribute", "rewriteValue"],
                "properties": {
                  "selector": { "type": "string", "minLength": 1 },
                  "attribute": {
                    "type": "string",
                    "pattern": "^(?:aria-[a-z0-9-]+|role|hidden|id|tabindex|href|data-listener-attached|onclick)$"
                  },
                  "operation": { "const": "rewrite" },
                  "rewriteValue": { "type": ["string", "number", "boolean"] }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["selector", "ignoreElement"],
                "properties": {
                  "selector": { "type": "string", "minLength": 1 },
                  "ignoreElement": { "const": true }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["selector", "ignoreSubtree"],
                "properties": {
                  "selector": { "type": "string", "minLength": 1 },
                  "ignoreSubtree": { "const": true }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["sourceUrls"],
      "properties": {
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
