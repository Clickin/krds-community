{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krds-community.dev/schemas/conformance-erratum.json",
  "title": "KRDS accessibility erratum",
  "type": "object",
  "required": [
    "id",
    "component",
    "upstream",
    "defect",
    "correction",
    "fixtures",
    "normalization",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^errata\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
    "component": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "upstream": {
      "type": "object",
      "required": ["version", "files"],
      "properties": {
        "version": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^upstream/" }
        }
      },
      "additionalProperties": false
    },
    "defect": {
      "type": "object",
      "required": ["type", "literalSource"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "literalSource": {
          "type": "object",
          "required": ["selectors", "behavior"],
          "properties": {
            "selectors": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "behavior": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": ["behavior", "attributes"],
      "properties": {
        "behavior": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["selector", "attribute", "rule"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "attribute": { "type": "string", "pattern": "^(aria-|role$|hidden$|id$)" },
              "rule": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "normalization": {
      "type": "object",
      "required": ["whitelist"],
      "properties": {
        "whitelist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["selector", "attribute", "rule"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "attribute": { "type": "string", "pattern": "^(aria-|role$|hidden$|id$)" },
              "rule": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["sourceUrls"],
      "properties": {
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
